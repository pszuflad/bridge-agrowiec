/**
 * Bridge Agrowca — Selly injection
 * v1 - dodaje zakładkę "Selly" w sidebarze panelu React
 *      + renderuje pełny widok integracji Selly.pl w kontenerze <main>
 *
 * Architektura (analogiczna do pending-injection.js):
 *  - MutationObserver / interval nasłuchuje na React DOM
 *  - Dodaje link "Selly" do sidebar nav (po ostatniej zakładce)
 *  - Nasłuchuje na hashchange - gdy hash to #/selly, ukrywa React content
 *    i renderuje własny widok Selly wewnątrz kontenera <main>
 *  - Używa /panel/api/selly/* endpointów (routes przez .htaccess)
 *  - Autoryzacja: JWT z localStorage (klucz 'bridge_token' - jak w istniejącym selly.html)
 */
(function () {
  'use strict';

  const VERSION = 'v3';
  const API_BASE = '/panel/api/selly';
  // Uwaga: React router panelu zna tylko konkretne route'y (#/, #/staging, ...).
  // Cokolwiek innego (#/selly, #/?view=selly) traktuje jako 'Not Found' i
  // rozmontowuje layout (sidebar + main). Dlatego trzymamy link Selly na hashu
  // '#/' (dashboard - React renderuje pełen layout), a stan 'jestem na Selly'
  // trzymamy w sessionStorage. Nasz injector wykrywa flagę i overlayuje
  // widok Selly nad <main>, ukrywając React content.
  const FLAG_KEY = 'sellyViewActive';
  const HASH = '#/'; // link Selly wskazuje na dashboard, aby React nie rozmontował layoutu
  const LABEL = 'Selly';

  const state = {
    lastRoute: null,
    injectedNav: false,
    injectedView: false,
    dostawcy: [],
  };

  // ============ CSS ============
  const CSS = `
    /* Sidebar link "Selly" - dopasowany do reszty */
