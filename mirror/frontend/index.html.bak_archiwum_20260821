    <style>
      /* POPRAWKA 2026-07-07 (v3): sticky naglowki kolumn.
         Wrapper tabeli staje sie kontenerem przewijania pionowego (max-height + overflow-y auto),
         dzieki temu thead sticky top:0 faktycznie przykleja sie do gory podczas scrolla.
         Lewy sidebar nawigacji to osobny element flex - nie jest dotykany.
         Tlo naglowka nieprzezroczyste + dolna ramka = czytelne odseparowanie od wierszy. */
      /* POPRAWKA 2026-07-13: usunieto wewnetrzny max-height/overflow z tabeli.
         Teraz jedynym kontenerem przewijania pionowego jest <main> (h-screen + overflow-y-auto),
         co eliminuje podwojny/konfliktowy scroll (strona + tabela jednoczesnie).
         Sticky header tabeli dziala teraz wzgledem <main> jako najblizszego
         przewijalnego przodka - wciaz przykleja sie prawidlowo. Tabela rozciaga sie
         na cala wysokosc tresci, co daje wieksze okno widoku (wiecej wierszy na raz). */
      div.overflow-x-auto:has(> table) {
        overflow-x: auto;
        overflow-y: visible;
      }
      div.overflow-x-auto:has(> table) thead,
      div.overflow-x-auto:has(> table) thead tr,
      div.overflow-x-auto:has(> table) thead th {
        position: sticky;
        top: 0;
        z-index: 6;
        background-color: #f1f5f9 !important;
        background-image: none !important;
        backdrop-filter: none !important;
        box-shadow: inset 0 -1px 0 hsl(var(--border, 214 32% 91%));
      }
      /* narozne naglowki (kod/Akcje, juz sticky poziomo) nad reszta */
      div.overflow-x-auto:has(> table) thead th.sticky,
      div.overflow-x-auto:has(> table) thead th[class*="sticky"] {
        z-index: 8;
      }
      /* komorki przyklejone poziomo - nieprzezroczyste tlo, by nie przeswitywaly */
      div.overflow-x-auto:has(> table) tbody td.sticky,
      div.overflow-x-auto:has(> table) tbody td[class*="sticky"] {
        background-color: #ffffff !important;
        background-image: none !important;
        backdrop-filter: none !important;
      }
      div.overflow-x-auto:has(> table) tbody td.sticky.right-0,
      div.overflow-x-auto:has(> table) tbody td[class*="right"][class*="sticky"] {
        background-color: #f1f5f9 !important;
        background-image: none !important;
        backdrop-filter: none !important;
      }
      /* POPRAWKA 2026-07-13: szerszy, latwiej chwytalny scrollbar wewnatrz tabeli
         (natywny scrollbar byl bardzo waski i trudny do zlapania/przeciagniecia myszka) */
      main {
        scrollbar-width: auto;
        outline: none;
      }
      main::-webkit-scrollbar {
        width: 14px;
        height: 14px;
      }
      main::-webkit-scrollbar-track {
        background: #e2e8f0;
      }
      main::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 7px;
        border: 2px solid #e2e8f0;
      }
      main::-webkit-scrollbar-thumb:hover {
        background: #64748b;
      }
      .dark main::-webkit-scrollbar-track {
        background: #1e293b;
      }
      .dark main::-webkit-scrollbar-thumb {
        background: #475569;
        border-color: #1e293b;
      }
      /* tryb ciemny: nieprzezroczyste tlo dopasowane do motywu */
      @media (prefers-color-scheme: dark) {
        div.overflow-x-auto:has(> table) thead,
        div.overflow-x-auto:has(> table) thead tr,
        div.overflow-x-auto:has(> table) thead th {
          background-color: #1e293b !important;
        }
        div.overflow-x-auto:has(> table) tbody td.sticky,
        div.overflow-x-auto:has(> table) tbody td[class*="sticky"] {
          background-color: #0f172a !important;
        }
        div.overflow-x-auto:has(> table) tbody td.sticky.right-0,
        div.overflow-x-auto:has(> table) tbody td[class*="right"][class*="sticky"] {
          background-color: #1e293b !important;
        }
      }
      /* jesli aplikacja uzywa klasy .dark na root (Tailwind dark mode class-based) */
      .dark div.overflow-x-auto:has(> table) thead,
      .dark div.overflow-x-auto:has(> table) thead tr,
      .dark div.overflow-x-auto:has(> table) thead th {
        background-color: #1e293b !important;
