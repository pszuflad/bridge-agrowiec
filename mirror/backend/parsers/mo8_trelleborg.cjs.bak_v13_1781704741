// MO8 Trelleborg parser
// Plik: Trelleborg.csv
// Kodowanie: UTF-8 (z uszkodzonym nagłówkiem)
// Separator: ;
// Decyzja Anny: EAN w notacji naukowej - naprawiamy po stronie parsera,
//   przy utracie precyzji → flagujemy ean_lossy=true (Marta uzupełnia w stagingu)

const { parse } = require('csv-parse/sync');
const iconv = require('iconv-lite');
const fs = require('fs');
const c = require('../common.cjs');

const DOSTAWCA = 'MO8_Trelleborg';

const RODZAJ_MAP = {
  'rolnicze': 'rolnicze',
  'leśne': 'leśne',
  'lesne': 'leśne',
  'przemysłowe': 'przemysłowe',
  'przemyslowe': 'przemysłowe',
  'ciężarowe': 'ciężarowe',
  'ciezarowe': 'ciężarowe'
};

// Lista możliwych nazw kolumny BIEŻNIK z uszkodzonego nagłówka
const BIEZNIK_KEYS = ['BIEĹąÄ»NIK', 'BIEĄÂ»NIK', 'BIEÄąÂ»NIK', 'BIEŻNIK', 'BIEZNIK'];

function parseFile(filePath) {
  const buffer = fs.readFileSync(filePath);
  let text = iconv.decode(buffer, 'utf-8');
  // Naprawa znanego uszkodzenia line endings
  text = text.replace(/\u0085/g, '\n');

  const rows = parse(text, {
    delimiter: ';',
    columns: header => header.map(h => h ? h.trim() : h),
    skip_empty_lines: true,
    relax_column_count: true,
    bom: true,
    trim: true
  });

  const records = [];
  const errors = [];

  // Pierwszy wiersz - znajdź nazwę kolumny bieżnik
  const firstRow = rows[0] || {};
  const headerKeys = Object.keys(firstRow);
  const bieznikKey = headerKeys.find(k => BIEZNIK_KEYS.some(bk => k.toUpperCase().includes(bk.toUpperCase().substring(0, 5)))) || 'BIEŻNIK';
  const eanKey = headerKeys.find(k => k.toLowerCase().includes('ean')) || 'EAN Code';

  for (const row of rows) {
    try {
      const rozmiar = row['Rozmiar'] || '';
      const rozmiarAlt = row['Rozmiar alternatywny'] || '';
      const vfif = row['VF/IF'] || '';
      const cfo = row['CFO'] || '';
      const tltt = row['TT/TL'] || row['TL/TT'] || '';
      const lisi = row['LI/SI'] || '';
      const pr = row['PR'] || '';
      const producent = row['PRODUCENT'] || 'Trelleborg';
      const rodzajRaw = ((row['RODZAJ'] || row['RODZAJ '] || '')).toLowerCase().trim();
      const bieznik = row[bieznikKey] || '';
      const kodProd = row['Kod producenta'] || '';
      const eanRaw = row[eanKey];

      const nazwa = `OPONA ${rozmiar} ${bieznik} ${producent} ${lisi} ${tltt} ${vfif} ${cfo}`.replace(/\s+/g, ' ').trim();

      let kategoria = RODZAJ_MAP[rodzajRaw];
      if (!kategoria) kategoria = c.classifyByName(nazwa);

      const oznaczenia = [
        ...c.extractTechnicalMarks(nazwa),
        ...(vfif ? [vfif.trim()] : []),
        ...(cfo ? [cfo.trim()] : []),
        ...(tltt ? [tltt.trim()] : [])
      ].filter(Boolean);
      const oznaczeniaUnique = [...new Set(oznaczenia)];

      // EAN naukowy - normalizeEan zwróci {value, lossy} dla utraconej precyzji
      const eanResult = c.normalizeEan(eanRaw);

      const rec = c.normalizeRecord({
        ean: eanResult,
        kod_dostawcy: kodProd,
        nazwa: nazwa,
        producent: producent,
        model_bieznik: bieznik,
        rozmiar: rozmiar,
        rozmiar_alternatywny: rozmiarAlt || null,
        cena_zakupu: row['Cena'] || row['Cena '],
        stan_magazynowy: row['Magazyn'],
        kategoria: kategoria,
        oznaczenia_techniczne: oznaczeniaUnique,
        dostawca: DOSTAWCA,
        surowe_pola: row
      });
      records.push(rec);
    } catch (e) {
      errors.push({ row, error: e.message });
    }
  }

  return { records, errors, dostawca: DOSTAWCA };
}

module.exports = { parseFile, DOSTAWCA };
