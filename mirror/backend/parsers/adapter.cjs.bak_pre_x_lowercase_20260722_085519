      labelNoise: raw.labelNoise,
      labelSnow: raw.labelSnow,
      labelIce: raw.labelIce
    });

    if (kod === 'MO6') return tyre.normalizeAgrowiec({
      ean: raw.EAN,
      rozmiar: raw.Beschreibung,
      indeksy: raw['Beschreibung 2'],
      producent: raw.Hersteller,
      stan: raw.Lagerbestand,
      cena: raw.Cena,
      model: raw.Model,
      vfIf: raw['VF/IF'],
