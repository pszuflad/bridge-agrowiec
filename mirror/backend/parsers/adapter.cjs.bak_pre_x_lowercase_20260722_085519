      zakup1: raw['Zakup 1 szt'],
      magazyn: raw.Magazyn
    });

    if (kod === 'MO8') {
      const keys = Object.keys(raw);
      const bieznikKey = keys.find(k => /BIE|bie/i.test(k) && !/rozmiar/i.test(k));
      const eanKey = keys.find(k => /ean/i.test(k));
      return tyre.normalizeTrelleborg({
        rozmiar: raw.Rozmiar,
        vfIf: raw['VF/IF'],
        cfo: raw.CFO,
        rozmiarAlternatywny: raw['Rozmiar alternatywny'],
        tlTt: raw['TT/TL'] || raw['TL/TT'],
        liSi: raw['LI/SI'],
        pr: raw.PR,
        producent: raw.PRODUCENT,
        rodzaj: raw.RODZAJ || raw['RODZAJ '],
        bieznik: bieznikKey ? raw[bieznikKey] : null,
        kodProducenta: raw['Kod producenta'],
        ean: eanKey ? raw[eanKey] : null,
        cena: raw.Cena || raw['Cena '],
        magazyn: raw.Magazyn
      });
    }

    if (kod === 'MO9') return tyre.normalizeAgrorami({
      id: raw.id,
      // NAPRAWIONE 2026-07-13: kod_dostawcy (teraz = sku Agrorami, ustawiane w
      // mo9_agrorami_api.cjs) trzeba przekazac do normalizeAgrorami, inaczej ta
      // funkcja budowala kodDostawcy tylko z `id` (Magento entity_id) i poprawka
      // w parserze/tyre_params.cjs nigdy nie docierala do finalnego rekordu.
      kod_dostawcy: record.kod_dostawcy,
      ean: raw.ean,
      producent: raw.producent,
      bieznik: raw.bieznik,
      // POPRAWKA 2026-06-18: gdy surowa kolumna "rozmiar" jest pusta, parser MO9 (Agrorami)
      // sam juz wczesniej probowal wydobyc rozmiar z tekstu nazwy (sizeFromName) i zapisal
      // go w record.rozmiar — ale tutaj przekazywalismy tylko raw.rozmiar (pusty string),
      // wiec normalizeAgrorami nigdy nie widzial tego fallbacku i wysokosc wychodzila null,
      // mimo ze surowe.rozmiar w wyniku koncowym (przez inny fallback w adapterze) wygladal
      // poprawnie — klasyczny przypadek "podglad OK, dane strukturalne zepsute".
      rozmiar: firstValue(raw.rozmiar, record.rozmiar),
      nosnosc: raw.nosnosc,
      predkosc: raw.predkosc,
      tlTt: raw['tl/tt'],
      plotna: raw['pĹ‚otna'] || raw['płotna'] || raw.plotna,
      cena: raw.cena,
      magazyn: raw.magazyn,
      waga: raw.waga,
      kategoria: raw.kategoria,
      sezon: raw.sezon,
      // POPRAWKA 2026-07-21 (V-FLEXA/V-FLECTO): nazwa pelna z API, potrzebna
      // do wykrycia VF/IF gdy oznaczenie jest osobnym tokenem w nazwie, nie w biezniku.
      nazwa: raw.name_api,
      // POPRAWKA 2026-07-21 (bug bieznik): oznaczenie klasy L/E/G/R/C/I+cyfra wyciagniete
      // z modelu przez mo9_agrorami_api.cjs (parseAgroramiName/TREAD_CLASS_RE).
      oznaczenieBieznikaRaw: raw.oznaczenie_bieznika_api
    });

    if (kod === 'MO10') return tyre.normalizeGri({
      nrKat: raw['NR KAT'],
      ean: raw.EAN,
      bieznik: raw['Bieżnik'] || raw['BieĹĽnik'] || raw.Bieznik,
      rozmiar: raw.Rozmiar,
      ilosc: raw['ilość'] || raw['iloĹ›Ä‡'] || raw.ilosc,
      cena: raw['cena netto/szt']
    });
  } catch (e) {
    const identyfikator = firstValue(record.kod_dostawcy, record.ean, record.nazwa) || '(brak identyfikatora)';
    console.error(`[adapter] BLAD normalizacji dostawcy=${dostawcaKod} kod=${identyfikator}: ${e && e.message ? e.message : e}`);
    return null;
  }

  return null;
}

function recordToSurowe(record, dostawcaKod = record.dostawca) {
  const oz = Array.isArray(record.oznaczenia_techniczne) ? record.oznaczenia_techniczne : [];
  const enriched = normalizeBySupplier(dostawcaKod, record) || {};
  if (shouldRejectRecord(record, enriched)) return null;
  let kodDisplay = firstValue(enriched.kodDostawcy, record.kod_dostawcy);
  // POPRAWKA 2026-06-18: odrzucamy kod_dostawcy znieksztalcony przez notacje naukowa
  // Excela (np. "5,02E+12") — taki "kod" nie jest unikalny i nie powinien byc uzywany
  // jako identyfikator produktu. Pipeline ponizej (recordToSuroweDostawca) wygeneruje
  // wtedy stabilny syntetyczny kod z nazwy/rozmiaru zamiast tego.
  if (looksLikeMangledScientific(kodDisplay)) kodDisplay = null;
  // NAPRAWIONE 2026-07-13: products.kod (PRIMARY KEY produktu, uzywany do dopasowania
  // przy synchronizacji) MUSI zostac zbudowany ze stabilnego identyfikatora dostawcy,
  // NIEZALEZNEGO od kodDostawcy (pole wyswietlane w panelu, ktore np. dla MO9/Agrorami
  // teraz = sku i moze sie teoretycznie zmienic w przyszlosci wraz z ofertą dostawcy).
  // enriched.idStabilny (gdy dostawca go dostarcza, np. normalizeAgrorami -> Magento
  // entity_id) ma priorytet nad kodDisplay przy budowie PK — dla dostawcow, ktorzy nie
  // ustawiaja idStabilny, zachowanie jest identyczne jak wczesniej (fallback na kodDisplay).
  let kod = firstValue(enriched.idStabilny, kodDisplay);
  if (looksLikeMangledScientific(kod)) kod = null;
  // POPRAWKA 2026-07-21: standaryzacja pisowni marek (FarmPro->FARM PRO, GRIPEX->GRIP EX)
  // i zamiana pelnych frazy "STEEL BELTED"/"HIGH SPEED" na tokeny SB/HS, PRZED wykrywaniem
  // technicznych oznaczen ponizej - zeby detectTechMarks/stripTechMarks zobaczyly juz gotowe tokeny.
  const nazwaStd = standardizeBrandSpelling(firstValue(enriched.nazwaKoncowa, record.nazwa, ''));
  const nazwa = nazwaStd || '';

  // POPRAWKA 2026-07-07: wykrywanie SF/SB/HF/LS (i od 2026-07-21: HS) z nazwy + modelu +
  // oznaczeń technicznych, jako fallback gdy normalizator tyre_params.cjs nie złapał ich
  // (np. doklejone do modelu).
  const modelRawStd = standardizeBrandSpelling(firstValue(enriched.model, record.model_bieznik));
  const modelRaw = modelRawStd;
  const marks = detectTechMarks(nazwa, modelRaw, ...(Array.isArray(oz) ? oz : []));
  // oczyszczenie modelu/bieżnika z oznaczeń technicznych (SB/SF/HF/LS/HS nie należą do nazwy modelu)
  const modelBieznikClean = stripTechMarks(modelRaw);

  // POPRAWKA 2026-07-21 (standaryzacja WIELKICH liter, decyzja Anny): nazwa/marka/model/bieznik
  // oraz oznaczenieBieznika/rodzaj zapisujemy DRUKOWANYMI literami niezaleznie od pisowni feedu
  // (wszyscy dostawcy MO1-MO10). Uppercase na KONCU, po standardizeBrandSpelling/stripTechMarks,
  // aby objac takze wartosci z fallbackow (record.nazwa/record.model_bieznik).
  return {
    kod: kod ? String(kod) : null,
    kodDostawcy: kodDisplay ? String(kodDisplay) : null,
    ean: firstValue(enriched.ean, record.ean),

    nazwa: toUpperPL(nazwa),
    marka: toUpperPL(firstValue(enriched.marka, record.producent, record.marka)),
    model: toUpperPL(modelBieznikClean),
    bieznik: toUpperPL(modelBieznikClean),
    kategoria: firstValue(enriched.kategoria, record.kategoria),

    magazyn: null,
    magazynRaw: null,
    stan: firstValue(enriched.stan, record.stan_magazynowy),

    cenaZakupu: firstValue(enriched.cenaZakupu, record.cena_zakupu),
    cenaSprzedazy: null,

    rozmiar: firstValue(enriched.rozmiar, record.rozmiar, record.rozmiar_alternatywny),
    rozmiarAlternatywny: firstValue(enriched.rozmiarAlternatywny, record.rozmiar_alternatywny),
    szerokosc: enriched.szerokosc ?? null,
    profil: enriched.profil ?? null,
    srednica: enriched.srednica ?? null,
    konstrukcja: enriched.konstrukcja ?? null,
    indeksNosnosci: enriched.indeksNosnosci ?? null,
    indeksPredkosci: enriched.indeksPredkosci ?? null,
    tlTt: enriched.tlTt ?? null,
    vfIf: enriched.vfIf ?? null,
    pr: enriched.pr ?? null,
    wysokosc: enriched.wysokoscRzeczywistaCm ?? null,
    indeks1: null,
    indeks2: null,
    indeksy: buildIndeksy(enriched, oz, nazwa),

    dot: enriched.dot ?? null,
    waga: enriched.waga ?? null,
    sf: (enriched.sf || marks.sf) ? 'SF' : null,
    sb: (enriched.sb || marks.sb) ? 'SB' : null,
    hf: (enriched.hf || marks.hf) ? 'HF' : null,
    ls: (enriched.ls || marks.ls) ? 'LS' : null,
    hs: (enriched.hs || marks.hs) ? 'HS' : null,
    nro: enriched.nro ?? null,
    cho: enriched.cho ?? null,
    cfo: enriched.cfo ?? null,
    stubbleResistant: enriched.stubbleResistant ?? null,
    labelRolling: enriched.labelRolling ?? null,
    labelWet: enriched.labelWet ?? null,
    labelNoise: enriched.labelNoise ?? null,
    labelNoiseClass: enriched.labelNoiseClass ?? null,
    labelIce: enriched.labelIce ?? null,
    labelSnow: enriched.labelSnow ?? enriched.snow3pmsf ?? null,
    rodzaj: toUpperPL(enriched.oznaczenieBieznika ?? null),
    linkZdjecia: enriched.linkZdjecia ?? null,
    oznaczenieBieznika: toUpperPL(enriched.oznaczenieBieznika ?? null),
    sezon: enriched.sezon ?? null,
    ms: enriched.ms ?? null,
    snow3pmsf: enriched.snow3pmsf ?? null,
    wentyl: enriched.wentyl ?? null
  };
}

function recordToSuroweDostawca(dostawcaKod, record) {
  const enriched = normalizeBySupplier(dostawcaKod, record) || {};
  const s = recordToSurowe(record, dostawcaKod);
  if (!s) return null;
  const kod = baseSupplierCode(dostawcaKod, record);

  if (kod === 'MO2' && s.stan !== null) {
    s.magazynRaw = record.surowe_pola?.['Magazyn 1 ilosc'] ? 'Magazyn 1' : null;
  }
  if (kod === 'MO4') s.magazynRaw = 'Wroclaw';
  if (kod === 'MO5') s.magazynRaw = 'Rzeszow';
  if (kod === 'MO6' && record.surowe_pola?.Lagerbestand) {
    s.magazynRaw = record.surowe_pola.Lagerbestand;
  }

  if (!s.kod) s.kod = syntheticKod(kod, record, enriched);

  // POPRAWKA 2026-07-09: kolumna products.kod jest unikalna GLOBALNIE (dla wszystkich
  // dostawcow razem), a nie per-dostawca. Kod producenta opony (np. z Handlopex WR/RZ)
  // bywa identyczny dla tej samej opony sprzedawanej przez rozne magazyny/dostawcow
  // (potwierdzone: 694 z 728 kodow w pliku MO4 wystepuje takze w pliku MO5). Bez prefiksu
  // dostawcy, przy masowej akceptacji stagingu pierwszy zapisany dostawca "zajmowal" kod,
  // a kolejni dostawcy z tym samym kodem producenta dostawali blad UNIQUE constraint i ich
  // pozycje w ogole nie trafialy do katalogu (np. MO4 zostawalo tylko 24 z ~376 pozycji).
  // Od teraz KAZDY kod produktu ma prefiks dostawcy, zeby nigdy nie kolidowal z innym dostawca.
  if (s.kod && !new RegExp(`^${kod}_`).test(s.kod)) {
    s.kod = `${kod}_${s.kod}`;
  }

  return s;
}

function recordsToSurowe(dostawcaKod, records) {
  return records.map(record => recordToSuroweDostawca(dostawcaKod, record)).filter(Boolean);
}

module.exports = { recordToSurowe, recordToSuroweDostawca, recordsToSurowe };
