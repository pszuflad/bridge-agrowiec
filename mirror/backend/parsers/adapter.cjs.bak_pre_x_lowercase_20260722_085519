'use strict';

// Adapter: records z parserow -> format akceptowany przez tk(dostawca, surowe).
// Tutaj dopinamy wspolny normalizator parametrow opon, zeby import przekazywal
// strukturalne pola zamiast chowania ich w nazwie/oznaczeniach technicznych.

const crypto = require('crypto');
const tyre = require('./tyre_params.cjs');

function firstValue(...values) {
  for (const value of values) {
    if (value !== undefined && value !== null && value !== '') return value;
  }
  return null;
}

// POPRAWKA 2026-07-07: Oznaczenia techniczne SF/SB/HF/LS czasem nie są lapane przez
// normalizatory tyre_params.cjs, gdy są doklejone do modelu/bieżnika (np. "MODEL SB")
// albo ukryte w nazwie. Tu wykrywamy je z tekstu i:
//  - ustawiamy odpowiednią flagę (sf/sb/hf/ls), jeśli normalizator tego nie zrobił,
//  - usuwamy je z pól `model` i `bieznik` (oznaczenie techniczne nie należy do nazwy modelu).
// Działa dla obu ścieżek importu (ręcznej i URL), bo obie przechodzą przez ten adapter.
const TECH_MARK_RE = /(?<![A-Za-z])(SF|SB|HF|LS|HS)(?![A-Za-z])/g;

// POPRAWKA 2026-07-21 (standaryzacja marek/dopiskow, decyzja Anny): niektorzy dostawcy
// wpisuja niejednolicie pisane marki ("FarmPro"/"FarmPRO"/"FARMPRO", "GRIPEX" bez spacji)
// i pisza pelnymi slowami dopiski ktore powinny byc skroconymi tokenami jak SB/SF/HF/LS
// ( "STEEL BELTED" -> SB, "HIGH SPEED" -> HS ). Dziala na `nazwa` + `modelRaw` PRZED
// detectTechMarks/stripTechMarks, zeby te pelne frazy zostaly zamienione na tokeny ktore
// istniejacy mechanizm juz umie wykryc i wyciac z modelu/biegnika.
function standardizeBrandSpelling(text) {
  if (text === null || text === undefined || text === '') return text;
  let s = String(text);
  // FarmPro / FarmPRO / FARMPRO / farm pro -> FARM PRO (tylko marka, reszta modelu bez zmian)
  s = s.replace(/\bfarm\s*pro\b/gi, 'FARM PRO');
  // GRIPEX (bez spacji) -> GRIP EX
  s = s.replace(/\bGRIPEX\b/gi, 'GRIP EX');
  // STEEL BELTED (pelna fraza) -> SB (NIE dotyka skrotu "STBT" - to inne oznaczenie, poza zakresem)
  s = s.replace(/\bsteel\s*belted\b/gi, 'SB');
  // HIGH SPEED (pelna fraza) -> HS
  s = s.replace(/\bhigh\s*speed\b/gi, 'HS');
  return s.replace(/\s+/g, ' ').trim();
}

function detectTechMarks(...texts) {
  const found = { sf: false, sb: false, hf: false, ls: false, hs: false };
  const text = texts.filter(t => t !== null && t !== undefined && t !== '').join(' ');
  if (!text) return found;
  let m;
  TECH_MARK_RE.lastIndex = 0;
  while ((m = TECH_MARK_RE.exec(text)) !== null) {
    const k = m[1].toLowerCase();
    if (k in found) found[k] = true;
  }
  return found;
}

function stripTechMarks(value) {
  if (value === null || value === undefined || value === '') return value;
  return String(value)
    .replace(TECH_MARK_RE, '')
    .replace(/\s{2,}/g, ' ')
    .replace(/^\s*[\-–—]\s*/, '')
    .trim();
}

// POPRAWKA 2026-06-18: Excel przy eksporcie CSV czasem zaokragla dlugie numery
// (np. "Kod producenta") do notacji naukowej, np. "5,02E+12". Realne dane Trelleborg
// pokazaly, ze taki znieksztalcony kod jest IDENTYCZNY dla wielu (np. 48) calkowicie
// roznych opon (rozna nazwa, rozmiar) — bez tej detekcji wszystkie one dostawalyby
// ten sam "kod", co psuje unikalnosc identyfikatora produktu (dostawca+kod).
function looksLikeMangledScientific(value) {
  if (value === null || value === undefined) return false;
  return /^-?\d+(?:[.,]\d+)?E[+-]?\d+$/i.test(String(value).trim());
}

function syntheticKod(dostawcaKod, record, enriched = {}) {
  // POPRAWKA 2026-06-18: jesli EAN jest oznaczony jako "lossy" (utracona precyzja przez
  // notacje naukowa Excela), NIE uzywamy go jako bazy identyfikatora — taki EAN bywa
  // identyczny dla wielu roznych produktow (potwierdzone na realnych danych Trelleborg:
  // 48 roznych opon z tym samym zaokraglonym EAN). Wtedy budujemy hash z nazwy/rozmiaru.
  const eanLossy = !!record.ean_lossy;
  const ean = !eanLossy ? firstValue(enriched.ean, record.ean) : null;
  if (ean) return String(ean);
  const basis = [
    enriched.nazwaKoncowa,
    record.nazwa,
    enriched.rozmiar,
    record.rozmiar,
    enriched.marka,
    record.producent,
    enriched.model,
    record.model_bieznik
  ].filter(Boolean).join('|').trim().toUpperCase().replace(/\s+/g, ' ');
  if (!basis) return null;
  const h = crypto.createHash('sha1').update(`${dostawcaKod}|${basis}`).digest('hex').slice(0, 14);
  return `${dostawcaKod}_${h.toUpperCase()}`;
}

// ============================================================================
// POPRAWKA 2026-07-08: kanoniczny INDEKS nosnosci/predkosci.
// PROBLEM: stara buildIndeksy w fallbacku sklejala oznaczenia techniczne
//   (technicalMarks.join) -> smieci typu "PRTT", "HDTL", "TL14PR" w kolumnie indeksy.
//   Dodatkowo notacja ln/lp produkowala zdublowana litere ("106A8A8") i uszkodzony
//   wariant dual-speed ("160A8/BA8").
// ROZWIAZANIE: buduj TYLKO realne indeksy (LI+SI). Zachowuj legalne warianty
//   podwojne/potrojne (dual-speed "160A8/B", dual-load "103A6/98A8",
//   triple "154L/150M/148L"). Oznaczenia techniczne (PR/TT/TL/SB/HD/M+S/3PMSF...)
//   NIE sa indeksem -> null gdy brak realnego indeksu.
// Zweryfikowane z dokumentacja BKT/Bohnenkamp. Ta sama logika uzyta w backfillu.
// ============================================================================
const _MARK_RE = /\b(?:\d{1,2}\s*P?PR|TTF|TT|TL|SB|HD|VF|IF|SF|HF|LS|NRO|CHO|CFO|MPT|IND|TR\d*|M\+S|3PMSF)\b/gi;
const _VALID_SI = /^[A-Z]\d?$/;

function _splitAxis(tok) {
  const m = String(tok || '').toUpperCase().match(/^(\d{2,3})([A-Z]\d?)$/);
  return m ? { li: m[1], si: m[2] } : null;
}
function _dedupSI(tok) {
  const m = String(tok || '').toUpperCase().match(/^(\d{2,3})([A-Z]\d?)\2$/);
  return m ? `${m[1]}${m[2]}` : tok;
}
function _assembleAxes(axes) {
  const out = [];
  for (const a of axes) {
    if (a.li && a.si && _VALID_SI.test(a.si)) {
      out.push({ li: a.li, si: a.si, extraSpeeds: [] });
    } else if (a.li == null && a.si && _VALID_SI.test(a.si) && out.length) {
      out[out.length - 1].extraSpeeds.push(a.si);
    }
  }
  if (!out.length) return null;
  const seen = new Set();
  const parts = [];
  for (const ax of out) {
    const extras = [...new Set(ax.extraSpeeds.filter(s => s && s !== ax.si))];
    const primary = `${ax.li}${ax.si}`;
    const key = primary + extras.join(',');
    if (seen.has(key)) continue;
    seen.add(key);
    parts.push(extras.length ? primary + '/' + extras.join('/') : primary);
  }
  const uniqParts = [...new Set(parts)];
  return uniqParts.length ? uniqParts.join('/') : null;
}
function _canonFromLnLp(ln, lp) {
  if (ln == null && lp == null) return null;
  const L = String(ln || '').toUpperCase().replace(/\s+/g, '');
  const P = String(lp || '').toUpperCase().replace(/\s+/g, '');
  if (!L && !P) return null;
  const loadParts = L.split('/');
  const speedParts = P.split('/');
  const speedsClean = speedParts.filter(Boolean);
  const sharedSpeed = speedsClean.length === 1 ? speedsClean[0] : null;
  const axes = [];
  const maxLen = Math.max(loadParts.length, speedParts.length);
  for (let i = 0; i < maxLen; i++) {
    let load = (loadParts[i] || '').trim();
    let spd = (speedParts[i] || '').trim();
    if (!load) continue;
    if (/^\d{1,2}P?PR$/.test(load)) continue;
    const withSpeed = _splitAxis(load);
    if (withSpeed) { axes.push({ li: withSpeed.li, si: withSpeed.si }); continue; }
    const numOnly = load.match(/^(\d{2,3})$/);
    if (numOnly) {
      let s = spd || sharedSpeed || '';
      const sm = s.match(/^([A-Z]\d?)/);
      axes.push({ li: numOnly[1], si: sm ? sm[1] : null });
      continue;
    }
    const bareSi = load.match(/^([A-Z]\d?)$/);
    if (bareSi) { axes.push({ li: null, si: bareSi[1] }); continue; }
    const glued = load.match(/^(\d{3})(\d{3})$/);
    if (glued) {
      const s = (spd || sharedSpeed || '').match(/^([A-Z]\d?)/);
      axes.push({ li: glued[1], si: s ? s[1] : null });
      axes.push({ li: glued[2], si: s ? s[1] : null });
      continue;
    }
  }
  return _assembleAxes(axes);
}
function _indeksFromName(name) {
  if (!name) return null;
  let t = ' ' + String(name).toUpperCase() + ' ';
  t = t.replace(/\(([^)]*)\)/g, ' ');
  t = t.replace(/\d+(?:\.\d+)?[\/X]\d+(?:\.\d+)?(?:R|-)\d+(?:\.\d+)?/gi, ' ');
  t = t.replace(/\d+(?:\.\d+)?L?-\d+(?:\.\d+)?/gi, ' ');
  t = t.replace(/\d+(?:\.\d+)?X\d+(?:\.\d+)?/gi, ' ');
  t = t.replace(/\d+(?:\.\d+)?R\d+(?:\.\d+)?/gi, ' ');
  t = t.replace(_MARK_RE, ' ');
  const triLoad = t.match(/(?<![A-Z0-9.])(\d{2,3}[A-Z]\d?)\/(\d{2,3}[A-Z]\d?)\/(\d{2,3}[A-Z]\d?)(?![0-9])/);
  if (triLoad) return _dedupSI(triLoad[1]) + '/' + _dedupSI(triLoad[2]) + '/' + _dedupSI(triLoad[3]);
  const dblLoad = t.match(/(?<![A-Z0-9.])(\d{2,3}[A-Z]\d?)\/(\d{2,3}[A-Z]\d?)(?:[A-Z]\d?)?(?![0-9])/);
  if (dblLoad) return _dedupSI(dblLoad[1]) + '/' + _dedupSI(dblLoad[2]);
  const dblSpeed = t.match(/(?<![A-Z0-9.])(\d{2,3})([A-Z]\d?)\/([A-Z]\d?)(?![0-9])/);
  if (dblSpeed && dblSpeed[2] !== dblSpeed[3]) return `${dblSpeed[1]}${dblSpeed[2]}/${dblSpeed[3]}`;
  if (dblSpeed) return `${dblSpeed[1]}${dblSpeed[2]}`;
  const sharedL = t.match(/(?<![A-Z0-9.])(\d{2,3})\/(\d{2,3})([A-Z]\d?)(?![0-9])/);
  if (sharedL) return `${sharedL[1]}${sharedL[3]}/${sharedL[2]}${sharedL[3]}`;
  const dblEnd = t.match(/(?<![A-Z0-9.])(\d{2,3})([A-Z]\d?)\2(?![0-9])/);
  if (dblEnd) return `${dblEnd[1]}${dblEnd[2]}`;
  const single = t.match(/(?<![A-Z0-9.])(\d{2,3})([A-Z])(\d)?(?![A-Z0-9])/);
  if (single) return `${single[1]}${single[2]}${single[3] || ''}`;
  return null;
}
function _isCleanIndeks(v) {
  if (v == null || v === '') return true;
  const s = String(v).trim();
  if (s === '') return true;
  const segs = s.split('/');
  if (!/^\d{2,3}[A-Z]\d?$/.test(segs[0])) return false;
  for (let i = 1; i < segs.length; i++) {
    if (!/^(\d{2,3}[A-Z]\d?|[A-Z]\d?)$/.test(segs[i])) return false;
  }
  return true;
}
function canonicalIndeks(name, ln, lp, rawIndeksy) {
  if (_isCleanIndeks(rawIndeksy) && rawIndeksy != null && String(rawIndeksy).trim() !== '') {
    return String(rawIndeksy).trim();
  }
  const fromStruct = _canonFromLnLp(ln, lp);
  const fromName = _indeksFromName(name);
  if (fromStruct && fromName) {
    const nStruct = fromStruct.split('/').length;
    const nName = fromName.split('/').length;
    return nName > nStruct ? fromName : fromStruct;
  }
  if (fromStruct) return fromStruct;
  if (fromName) return fromName;
  return null;
}

// Wrapper zachowujacy stara sygnature. UWAGA: technicalMarks NIE sa juz sklejane
// w indeks (to byl bug). Budujemy indeks wylacznie z realnych pol LI/SI + nazwy.
function buildIndeksy(enriched, technicalMarks = [], nazwa = null) {
  const load = firstValue(enriched.indeksNosnosci);
  const speed = firstValue(enriched.indeksPredkosci);
  const name = firstValue(nazwa, enriched.nazwaKoncowa, enriched.nazwa);
  return canonicalIndeks(name, load, speed, null);
}

function baseSupplierCode(dostawcaKod, record) {
  const source = dostawcaKod || record.dostawca || '';
  return String(source).toUpperCase().split('_')[0];
}

function shouldRejectRecord(record, enriched) {
  if (enriched && enriched.odrzucony) return true;
  const text = [
    record?.nazwa,
    record?.model_bieznik,
    record?.kategoria,
    enriched?.nazwaKoncowa,
    enriched?.model,
    enriched?.kategoria
  ].filter(Boolean).join(' ');
  // POPRAWKA 2026-06-18: JS \b nie dziala poprawnie przy polskich znakach diakrytycznych
  // (np. "ł", "ś" nie sa traktowane jako \w), co powodowalo, ze warianty takie jak
  // "kół" (nie wykrywany na granicy koncowej) albo "śruba"/"śrubki" (nie wykrywany na
  // granicy startowej) NIGDY nie byly faktycznie dopasowywane, mimo ze wystepowaly w liscie.
  // Zamiast \b uzywamy lookbehind/lookahead z negacja klasy polskich liter.
  const PL = 'a-ząćęłńóśźż';
  // POPRAWKA 2026-06-18: Bohnenkamp (dostawca niemiecki) ma w katalogu pozycje typu
  // "PKW-VENTIL, TR 415 (SNAP IN)", "LKW-FELGENVENTIL 32 MS", "METALLVENTIL 42 MS" —
  // to wentyle/zaworki do felg, nie opony. Wczesniejsza lista mialo tylko polskie
  // "wentyl/wentyle", co nie lapalo niemieckiego "ventil" i te pozycje przechodzily
  // jako "opony" z rozmiar=null, wysokosc=null (cichy blad widoczny tylko po realnych
  // danych Bohnenkamp).
  const accessoryRe = new RegExp(
    `(?<![${PL}])(koła|koło|kola|kolo|kół|zawory|zawór|zawor|oring|oringi|o-ring|o-ringi|obręcz|obręcze|obrecz|obrecze|ochraniacz|ochraniacze|felga|felgi|felg|śruba|śrubki|śrubek|sruba|srubki|srubek|nakrętka|nakrętki|nakrętek|nakretka|nakretki|nakretek|dętka|dętki|detka|detki|wentyl|wentyle)(?![${PL}])`,
    'i'
  );
  // POPRAWKA 2026-06-18 (2): "ventil" w realnych danych Bohnenkamp wystepuje prawie
  // zawsze jako czesc niemieckiego zlozenia bez spacji (np. "FELGENVENTIL",
  // "METALLVENTIL", "PKW-VENTIL") — granica (?<![PL]) wymagana przez accessoryRe
  // blokuje dopasowanie, bo przed "VENTIL" stoi litera ("N" w FELGENVENTIL, "L" w
  // METALLVENTIL), nie separator. "ventil" jako fragment slowa jest wystarczajaco
  // specyficzny, zeby sprawdzac go bez granic.
  const ventilRe = /ventil/i;
  return /bie[zż]nikowan/i.test(text) ||
    /\bquad\b/i.test(text) ||
    /\batv\b/i.test(text) ||
    /\bd?tki?\b/i.test(text) ||
    /\bdetki?\b/i.test(text) ||
    accessoryRe.test(text) ||
    ventilRe.test(text);
}

// POPRAWKA 2026-07-21 (standaryzacja WIELKICH liter, decyzja Anny):
// Wszystkie pola tekstowe identyfikujace produkt w katalogu maja byc zapisane
// DRUKOWANYMI literami niezaleznie od tego, jak poda je feed dostawcy (MO1-MO10).
// Standaryzacja w jednym miejscu (adapter) obejmuje wszystkich dostawcow.
// Obejmuje: nazwa, nazwaKoncowa, model, bieznik, oznaczenieBieznika.
// NIE ruszamy: kodDostawcy, ean, linkow, cen, kategorii (klucze techniczne/systemowe).
function toUpperPL(v) {
  if (typeof v !== 'string' || !v) return v;
  // toLocaleUpperCase('pl-PL') poprawnie zamienia polskie znaki (ł->Ł, ś->Ś itd.)
  return v.toLocaleUpperCase('pl-PL').replace(/\s+/g, ' ').trim();
}

function normalizeBySupplier(dostawcaKod, record) {
  const kod = baseSupplierCode(dostawcaKod, record);
  const raw = record.surowe_pola || {};

  try {
    if (kod === 'MO1') return tyre.normalizeBohnenkamp(Array.isArray(raw.row) ? raw.row : []);

    if (kod === 'MO2') return tyre.normalizeJmk({
      kodProducenta: raw['Kod producenta'],
      ean: raw.ean,
      producent: raw.Producent,
      bieznik: raw['Bieżnik'] || raw.Bieznik || raw['BieĹĽnik'],
      rodzaj: raw.Rodzaj,
      nazwa: raw.nazwa,
      szerokosc: raw.szerokosc,
      profil: raw.profil,
      srednica: raw.srednica,
      indeksPredkosci1: raw['Indeks predkosci 1'] || raw['Indeks prÄ™dkoĹ›ci 1'] || raw['Indeks prędkości 1'],
      indeksPredkosci2: raw['Indeks Predkosci 2'] || raw['Indeks PrÄ™dkoĹ›ci 2'] || raw['Indeks Prędkości 2'],
      indeksNosnosci1: raw['Indeks Nosnosc 1'] || raw['Indeks NoĹ›noĹ›Ä‡ 1'] || raw['Indeks Nośność 1'],
      indeksNosnosci2: raw['Indeks Nosnosc 2'] || raw['Indeks NoĹ›noĹ›Ä‡ 2'] || raw['Indeks Nośność 2'],
      zamiennik: raw.Zamiennik,
      magazyn1: raw['Magazyn 1 ilosc'],
      magazyn2: raw['Magazyn 2 ilosc'],
      cenaKlientNetto: raw['Cena klient netto'],
      oporToczenia: raw['Opor toczenia'] || raw['OpĂłr toczenia'] || raw['Opór toczenia'],
      przyczepnosc: raw['Przyczepność'] || raw.Przyczepnosc || raw['PrzyczepnoĹ›Ä‡'],
      halasKlasa: raw['Halas Klasa'] || raw['HaĹ‚as Klasa'] || raw['Hałas Klasa'],
      halasDb: raw['Halas dB'] || raw['HaĹ‚as dB'] || raw['Hałas dB'],
      dot: raw.Dot,
      konstrukcja: raw.Konstrukcja,
      masaBrutto: raw['Masa brutto']
    });

    if (kod === 'MO3') return tyre.normalizeGrasdorf({
      eanCode: firstValue(raw.eanCode, raw.ean, raw.EAN),
      indexCatalogue: firstValue(raw.indexCatalogue, raw['Index Catalogue'], raw['Indeks producenta'], raw.id),
      name: firstValue(raw.name, raw.nazwa),
      additionalName: raw.additionalName,
      priceNet: firstValue(raw.priceNet, raw.cena),
      category: firstValue(raw.category, raw.kategoria),
      producer: firstValue(raw.producer, raw.producent),
      availabilityCount: firstValue(raw.availabilityCount, raw.stan_magazynu),
      imageUrls: raw.imageUrls,
      konstrukcja: firstValue(raw['Konstrukcja opony'], raw.konstrukcja),
      typ: raw.Typ,
      indeksNosnosci: raw['Indeks noĹ›noĹ›ci'] || raw['Indeks nośności'],
      iloscPlocien: raw['IloĹ›Ä‡ pĹ‚Ăłcien'] || raw['Ilość płócien'],
      zastosowanie: raw.Zastosowanie,
      rozmiarOpony: raw['Rozmiar opony'],
      weight: firstValue(raw.weight, raw.waga)
    });

    if (kod === 'MO4' || kod === 'MO5') return tyre.normalizeHandlopex({
      kodProducenta: raw['kod producenta'],
      symbolHandlopex: raw['symbol handlopex'],
      producent: raw.producent,
      nazwa: raw.nazwa,
      szerokosc: raw.szerokosc,
      profil: raw.profil,
