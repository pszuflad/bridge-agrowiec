// MO9 Agrorami parser
// Plik: agrorami.csv
// Kodowanie: UTF-8 z BOM
// Separator: ;
// Decyzja Anny:
//   - "quad" → ODRZUCAMY (nie wpuszczamy do bazy)
//   - "inne" → mapujemy na "rolnicze"
//   - Fallback po nazwie dla pozycji bez EAN

const { parse } = require('csv-parse/sync');
const iconv = require('iconv-lite');
const fs = require('fs');
const c = require('../common.cjs');

const DOSTAWCA = 'MO9_Agrorami';

const KATEGORIA_MAP = {
  'rolnicze': 'rolnicze',
  'leśne': 'leśne',
  'lesne': 'leśne',
  'przemysłowe': 'przemysłowe',
  'przemyslowe': 'przemysłowe',
  'ciężarowe': 'ciężarowe',
  'ciezarowe': 'ciężarowe',
  'dętki': 'dętki',
  'detki': 'dętki',
  'akcesoria': 'akcesoria',
  'inne': 'rolnicze' // DECYZJA ANNY: inne → rolnicze
};

function parseFile(filePath) {
  const buffer = fs.readFileSync(filePath);
  const text = iconv.decode(buffer, 'utf-8');

  const rows = parse(text, {
    delimiter: ';',
    columns: true,
    skip_empty_lines: true,
    relax_column_count: true,
    bom: true,
    trim: true
  });

  const records = [];
  const errors = [];
  const odrzucone = []; // Quady i inne odrzucone

  for (const row of rows) {
    try {
      const kategoriaRaw = (row['kategoria'] || '').toLowerCase().trim();

      // DECYZJA ANNY: quad odrzucamy
      if (kategoriaRaw === 'quad') {
        odrzucone.push({ powod: 'quad', row });
        continue;
      }

      const producent = row['producent'] || '';
      const bieznik = row['bieznik'] || '';
      let rozmiar = row['rozmiar'] || '';
      const nosnosc = row['nosnosc'] || '';
      const predkosc = row['predkosc'] || '';
      const tltt = row['tl/tt'] || '';

      // DECYZJA ANNY: override rozmiaru dla konkretnych pozycji, w których
      // dostawca w polu 'rozmiar' wpisuje indeksy zamiast wymiarów.
      // Klucz = id dostawcy z kolumny 'id' w CSV.
      const ROZMIAR_OVERRIDE = {
        '106946': '540/65R38' // BKT AGRIMAX RT 657 - zawsze 540/65R38
      };
      const idDostawcy = String(row['id'] || '').trim();
      if (ROZMIAR_OVERRIDE[idDostawcy]) {
        rozmiar = ROZMIAR_OVERRIDE[idDostawcy];
      }

      const nazwa = `OPONA ${rozmiar} ${bieznik} ${producent} ${nosnosc} ${tltt}`.replace(/\s+/g, ' ').trim();

      let kategoria = KATEGORIA_MAP[kategoriaRaw];
      if (!kategoria) {
        kategoria = c.classifyByName(nazwa);
      }

      const sizeFromName = c.extractSize(nazwa);

      const oznaczenia = [
        ...c.extractTechnicalMarks(nazwa),
        ...(tltt ? [tltt.trim()] : [])
      ].filter(Boolean);
      const oznaczeniaUnique = [...new Set(oznaczenia)];

      const rec = c.normalizeRecord({
        ean: c.normalizeEan(row['ean']),
        kod_dostawcy: row['id'],
        nazwa: nazwa,
        producent: producent,
        model_bieznik: bieznik,
        rozmiar: rozmiar || sizeFromName.rozmiar,
        rozmiar_alternatywny: sizeFromName.alternatywny,
        cena_zakupu: row['cena'],
        stan_magazynowy: row['magazyn'],
        kategoria: kategoria,
        oznaczenia_techniczne: oznaczeniaUnique,
        dostawca: DOSTAWCA,
        surowe_pola: row
      });
      records.push(rec);
    } catch (e) {
      errors.push({ row, error: e.message });
    }
  }

  return { records, errors, odrzucone, dostawca: DOSTAWCA };
}

module.exports = { parseFile, DOSTAWCA };
