'use strict';

// Adapter: records z parserow -> format akceptowany przez tk(dostawca, surowe).
// Tutaj dopinamy wspolny normalizator parametrow opon, zeby import przekazywal
// strukturalne pola zamiast chowania ich w nazwie/oznaczeniach technicznych.

const crypto = require('crypto');
const tyre = require('./tyre_params.cjs');

function firstValue(...values) {
  for (const value of values) {
    if (value !== undefined && value !== null && value !== '') return value;
  }
  return null;
}

// POPRAWKA 2026-06-18: Excel przy eksporcie CSV czasem zaokragla dlugie numery
// (np. "Kod producenta") do notacji naukowej, np. "5,02E+12". Realne dane Trelleborg
// pokazaly, ze taki znieksztalcony kod jest IDENTYCZNY dla wielu (np. 48) calkowicie
// roznych opon (rozna nazwa, rozmiar) — bez tej detekcji wszystkie one dostawalyby
// ten sam "kod", co psuje unikalnosc identyfikatora produktu (dostawca+kod).
function looksLikeMangledScientific(value) {
  if (value === null || value === undefined) return false;
  return /^-?\d+(?:[.,]\d+)?E[+-]?\d+$/i.test(String(value).trim());
}

// POPRAWKA 2026-06-23: ujednolicenie kategorii z parserow oraz domkniecie reguly P4.
// Cel: kategoria w staging/products ma byc spojna z slownikiem UI ("Ciezarowe",
// "Rolnicze", "Lesne", "Przemyslowe", "Akcesoria", "Detki", "Uzywane"). Diakrytyki
// w pliku zrodlowym zachowujemy zgodnie z decyzja uzytkownika (piszemy "ciężarowe",
// "przemysłowe" tak jak w pliku). Q5: nowa kategoria "Uzywane" dla opon uzywanych.
// P4: jezeli kategoria=ciezarowe i tl/tt jest puste, dopisujemy TL (domyslna
// konwencja w branzy dla nowoczesnych opon ciezarowych).
const USED_TIRE_RE = /uż[wy]wan|uży?wan|uzywan/i;

function isUsedTire(record, enriched) {
  const text = [
    record?.nazwa,
    record?.kategoria,
    record?.model_bieznik,
    record?.surowe_pola?.additionalName,
    enriched?.nazwaKoncowa,
    enriched?.model,
    enriched?.bieznik,
    enriched?.kategoria
  ].filter(Boolean).join(' ');
  if (!text) return false;
  return USED_TIRE_RE.test(text);
}

function canonicalizeKategoria(value) {
  if (!value) return null;
  const t = String(value).trim();
  if (!t) return null;
  // POPRAWKA 2026-06-23 (v2): kategorie w katalogu MUSZA byc identyczne z lista atrybutow
  // (slownik Marty) — a tam sa z wielkiej litery: Rolnicze, Leśne, Przemysłowe, Ciężarowe,
  // Używane. Wczesniej zapisywalismy male litery zgodnie z plikiem dostawcy, ale UI laczy
  // unie products.kategoria + atrybuty_wartosci(rodzaj='kategoria') i pokazywal duplikaty.
  // Lapiemy tez warianty bez polskich znakow oraz z U+FFFD (MO8 — zla strona kodowa).
  const lower = t.toLowerCase();
  // Ciezarowe
  if (/^cie[zż\u017C\uFFFD]arow[ae]$/.test(lower)) return 'Ciężarowe';
  if (lower === 'ciężarowe' || lower === 'ciężarowa' || lower === 'cię\u017Carowe' || lower === 'ciezarowe' || lower === 'ciezarowa') return 'Ciężarowe';
  // Przemyslowe (rodzaj zenski/meski oboje sa w danych)
  if (/^przemys[l\u0142\uFFFD]ow[ae]$/.test(lower)) return 'Przemysłowe';
  if (lower === 'przemysłowe' || lower === 'przemysłowa' || lower === 'przemyslowe' || lower === 'przemyslowa') return 'Przemysłowe';
  // Lesne
  if (/^le[s\u015B\uFFFD]n[ae]$/.test(lower)) return 'Leśne';
  if (lower === 'leśne' || lower === 'leśna' || lower === 'lesne' || lower === 'lesna') return 'Leśne';
  // Rolnicze
  if (lower === 'rolnicze' || lower === 'rolnicza') return 'Rolnicze';
  if (lower === 'rolnicze małe' || lower === 'rolnicze ma\u0142e' || lower === 'rolnicze male' || lower === 'rolnicze ma\uFFFDe') return 'Rolnicze';
  if (lower === 'inne') return 'Rolnicze';
  // Uzywane (zwracamy z wielkiej dla spojnosci ze slownikiem)
  if (lower === 'używane' || lower === 'używana' || lower === 'uzywane' || lower === 'uzywana') return 'Używane';
  return t;
}

function isCiezarowe(value) {
  if (!value) return false;
  return /^cie\u017Carow|^ci\u0119\u017Carow|^ciezarow|^cię\u017Carow|^ciężarow/i.test(String(value).trim());
}

// POPRAWKA 2026-06-23: VF/IF czesto bywa zaszyte w nazwie/rozmiarze jako prefiks lub token
// (np. "VF600/70R28" w MO7, "IF 600/70R30" w MO10, "... VF TL Bridgestone" w MO2,
// "IF  800/65  R32" w MO5, "VF600/65R28" w MO6). Parsery per-dostawca tych przypadkow
// nie wyciagaja — uzupelniamy tu, jezeli pole vfIf jest puste.
function extractVfIf(record, enriched) {
  // Zrodla tekstowe do skanu — surowa nazwa, model i rozmiar maja pierwszenstwo,
  // bo finalna enriched.nazwaKoncowa jest juz przeformatowana.
  const sources = [
    record?.rozmiar,
    record?.nazwa,
    record?.model_bieznik,
    enriched?.rozmiar,
    enriched?.nazwaKoncowa
  ].filter(v => v !== null && v !== undefined && v !== '').map(String);
  if (!sources.length) return null;

  // Wzorzec 1: prefiks z cyfra bez spacji — "VF600/70R28", "IF650/85R38"
  // Wzorzec 2: token z separatorem — "VF ", " IF ", "/VF", ";IF"
  // Wykluczamy "IFE", "VFR", "IFA", "VFLEX", "IFLEX" (nazwy modeli) — wymagamy
  // by po VF/IF byla cyfra, spacja przed cyfra, ukosnik, koniec stringa albo separator pola.
  for (const src of sources) {
    // Prefiks bezposrednio przed cyfra rozmiaru: "VF600", "IF650"
    let m = src.match(/(^|[\s\/;,\(\)\[\]])(VF|IF)(\d)/);
    if (m) return m[2];
    // Token z separatorem po obu stronach: " VF ", "/IF/", " VF/", " IF "
    m = src.match(/(^|[\s\/;,\(\)\[\]])(VF|IF)([\s\/;,\(\)\[\]]|$)/);
    if (m) return m[2];
    // Po podwojnej spacji (Handlopex Rz format "IF  800/65")
    m = src.match(/(?:^|\s)(VF|IF)\s{2,}\d/);
    if (m) return m[1];
  }
  return null;
}

function applyPostNormalize(enriched, record) {
  if (!enriched || typeof enriched !== 'object') return enriched;
  // 1. Kanoniczna kategoria z fallbackiem na record.kategoria
  let kategoria = canonicalizeKategoria(enriched.kategoria || record.kategoria || null);

  // 2. Q5: Uzywane wykrywamy po nazwie/biezniku/dodatkowych polach
  if (isUsedTire(record, enriched)) {
    kategoria = 'Używane';
  }

  // 3. P4: TL gdy ciezarowe i puste tlTt
  let tlTt = enriched.tlTt;
  if ((tlTt === null || tlTt === undefined || tlTt === '') && isCiezarowe(kategoria)) {
    tlTt = 'TL';
  }

  // 4. VF/IF z nazwy/rozmiaru, gdy parser nie wypelnil pola
  let vfIf = enriched.vfIf;
  if (vfIf === null || vfIf === undefined || vfIf === '') {
    const detected = extractVfIf(record, enriched);
    if (detected) vfIf = detected;
  }

  enriched.kategoria = kategoria;
  enriched.tlTt = tlTt;
  enriched.vfIf = vfIf;
  return enriched;
}

function syntheticKod(dostawcaKod, record, enriched = {}) {
  // POPRAWKA 2026-06-18: jesli EAN jest oznaczony jako "lossy" (utracona precyzja przez
  // notacje naukowa Excela), NIE uzywamy go jako bazy identyfikatora — taki EAN bywa
  // identyczny dla wielu roznych produktow (potwierdzone na realnych danych Trelleborg:
  // 48 roznych opon z tym samym zaokraglonym EAN). Wtedy budujemy hash z nazwy/rozmiaru.
  const eanLossy = !!record.ean_lossy;
  const ean = !eanLossy ? firstValue(enriched.ean, record.ean) : null;
  if (ean) return String(ean);
  const basis = [
    enriched.nazwaKoncowa,
    record.nazwa,
    enriched.rozmiar,
    record.rozmiar,
    enriched.marka,
    record.producent,
    enriched.model,
    record.model_bieznik
  ].filter(Boolean).join('|').trim().toUpperCase().replace(/\s+/g, ' ');
  if (!basis) return null;
  const h = crypto.createHash('sha1').update(`${dostawcaKod}|${basis}`).digest('hex').slice(0, 14);
  return `${dostawcaKod}_${h.toUpperCase()}`;
}

function buildIndeksy(enriched, technicalMarks = []) {
  const load = firstValue(enriched.indeksNosnosci);
  const speed = firstValue(enriched.indeksPredkosci);
  if (load && speed) {
    const loads = String(load).split('/');
    const speeds = String(speed).split('/');
    return loads
      .map((li, idx) => `${li}${speeds[idx] || speeds[0] || ''}`)
      .join('/')
      .replace(/\s+/g, '');
  }

  if (!Array.isArray(technicalMarks) || !technicalMarks.length) return null;
  return technicalMarks.join(' ').replace(/\s+/g, '');
}

function baseSupplierCode(dostawcaKod, record) {
  const source = dostawcaKod || record.dostawca || '';
  return String(source).toUpperCase().split('_')[0];
}

function shouldRejectRecord(record, enriched) {
  if (enriched && enriched.odrzucony) return true;
  const text = [
    record?.nazwa,
    record?.model_bieznik,
    record?.kategoria,
    enriched?.nazwaKoncowa,
    enriched?.model,
    enriched?.kategoria
  ].filter(Boolean).join(' ');
  // POPRAWKA 2026-06-18: JS \b nie dziala poprawnie przy polskich znakach diakrytycznych
  // (np. "ł", "ś" nie sa traktowane jako \w), co powodowalo, ze warianty takie jak
  // "kół" (nie wykrywany na granicy koncowej) albo "śruba"/"śrubki" (nie wykrywany na
  // granicy startowej) NIGDY nie byly faktycznie dopasowywane, mimo ze wystepowaly w liscie.
  // Zamiast \b uzywamy lookbehind/lookahead z negacja klasy polskich liter.
  const PL = 'a-ząćęłńóśźż';
  // POPRAWKA 2026-06-18: Bohnenkamp (dostawca niemiecki) ma w katalogu pozycje typu
  // "PKW-VENTIL, TR 415 (SNAP IN)", "LKW-FELGENVENTIL 32 MS", "METALLVENTIL 42 MS" —
  // to wentyle/zaworki do felg, nie opony. Wczesniejsza lista mialo tylko polskie
  // "wentyl/wentyle", co nie lapalo niemieckiego "ventil" i te pozycje przechodzily
  // jako "opony" z rozmiar=null, wysokosc=null (cichy blad widoczny tylko po realnych
  // danych Bohnenkamp).
  const accessoryRe = new RegExp(
    `(?<![${PL}])(koła|koło|kola|kolo|kół|zawory|zawór|zawor|oring|oringi|o-ring|o-ringi|obręcz|obręcze|obrecz|obrecze|ochraniacz|ochraniacze|felga|felgi|felg|śruba|śrubki|śrubek|sruba|srubki|srubek|nakrętka|nakrętki|nakrętek|nakretka|nakretki|nakretek|dętka|dętki|detka|detki|wentyl|wentyle)(?![${PL}])`,
    'i'
  );
  // POPRAWKA 2026-06-18 (2): "ventil" w realnych danych Bohnenkamp wystepuje prawie
  // zawsze jako czesc niemieckiego zlozenia bez spacji (np. "FELGENVENTIL",
  // "METALLVENTIL", "PKW-VENTIL") — granica (?<![PL]) wymagana przez accessoryRe
  // blokuje dopasowanie, bo przed "VENTIL" stoi litera ("N" w FELGENVENTIL, "L" w
  // METALLVENTIL), nie separator. "ventil" jako fragment slowa jest wystarczajaco
  // specyficzny, zeby sprawdzac go bez granic.
  const ventilRe = /ventil/i;
  return /bie[zż]nikowan/i.test(text) ||
    /\bquad\b/i.test(text) ||
    /\batv\b/i.test(text) ||
    /\bd?tki?\b/i.test(text) ||
    /\bdetki?\b/i.test(text) ||
    accessoryRe.test(text) ||
    ventilRe.test(text);
}

function normalizeBySupplier(dostawcaKod, record) {
  const kod = baseSupplierCode(dostawcaKod, record);
  const raw = record.surowe_pola || {};

  try {
    if (kod === 'MO1') return tyre.normalizeBohnenkamp(Array.isArray(raw.row) ? raw.row : []);

    if (kod === 'MO2') return tyre.normalizeJmk({
      kodProducenta: raw['Kod producenta'],
      ean: raw.ean,
      producent: raw.Producent,
      bieznik: raw.Bieznik || raw['BieĹĽnik'],
      rodzaj: raw.Rodzaj,
      nazwa: raw.nazwa,
      szerokosc: raw.szerokosc,
      profil: raw.profil,
      srednica: raw.srednica,
      indeksPredkosci1: raw['Indeks predkosci 1'] || raw['Indeks prÄ™dkoĹ›ci 1'] || raw['Indeks prędkości 1'],
      indeksPredkosci2: raw['Indeks Predkosci 2'] || raw['Indeks PrÄ™dkoĹ›ci 2'] || raw['Indeks Prędkości 2'],
      indeksNosnosci1: raw['Indeks Nosnosc 1'] || raw['Indeks NoĹ›noĹ›Ä‡ 1'] || raw['Indeks Nośność 1'],
      indeksNosnosci2: raw['Indeks Nosnosc 2'] || raw['Indeks NoĹ›noĹ›Ä‡ 2'] || raw['Indeks Nośność 2'],
      zamiennik: raw.Zamiennik,
      magazyn1: raw['Magazyn 1 ilosc'],
      magazyn2: raw['Magazyn 2 ilosc'],
      cenaKlientNetto: raw['Cena klient netto'],
      oporToczenia: raw['Opor toczenia'] || raw['OpĂłr toczenia'] || raw['Opór toczenia'],
      przyczepnosc: raw.Przyczepnosc || raw['PrzyczepnoĹ›Ä‡'] || raw['Przyczepność'],
      halasKlasa: raw['Halas Klasa'] || raw['HaĹ‚as Klasa'] || raw['Hałas Klasa'],
      halasDb: raw['Halas dB'] || raw['HaĹ‚as dB'] || raw['Hałas dB'],
      dot: raw.Dot,
      konstrukcja: raw.Konstrukcja,
      masaBrutto: raw['Masa brutto']
    });

    if (kod === 'MO3') return tyre.normalizeGrasdorf({
      eanCode: firstValue(raw.eanCode, raw.ean, raw.EAN),
      indexCatalogue: firstValue(raw.indexCatalogue, raw['Index Catalogue'], raw['Indeks producenta'], raw.id),
      name: firstValue(raw.name, raw.nazwa),
      additionalName: raw.additionalName,
      priceNet: firstValue(raw.priceNet, raw.cena),
      category: firstValue(raw.category, raw.kategoria),
      producer: firstValue(raw.producer, raw.producent),
      availabilityCount: firstValue(raw.availabilityCount, raw.stan_magazynu),
      imageUrls: raw.imageUrls,
      konstrukcja: firstValue(raw['Konstrukcja opony'], raw.konstrukcja),
      typ: raw.Typ,
      indeksNosnosci: raw['Indeks noĹ›noĹ›ci'] || raw['Indeks nośności'],
      iloscPlocien: raw['IloĹ›Ä‡ pĹ‚Ăłcien'] || raw['Ilość płócien'],
      zastosowanie: raw.Zastosowanie,
      rozmiarOpony: raw['Rozmiar opony'],
      weight: firstValue(raw.weight, raw.waga)
    });

    if (kod === 'MO4' || kod === 'MO5') return tyre.normalizeHandlopex({
      kodProducenta: raw['kod producenta'],
      symbolHandlopex: raw['symbol handlopex'],
      producent: raw.producent,
      nazwa: raw.nazwa,
      szerokosc: raw.szerokosc,
      profil: raw.profil,
      srednica: raw.srednica,
      indeksPredkosci: raw['indeks pr.'],
      indeksNosnosci: raw['indeks nosn.'],
      ilosc: raw.ilosc,
      cenaHurtNetto: raw['cena hurt netto'],
      ean: raw.ean,
      oporToczenia: raw['opor toczenia'],
      przyczepnosc: raw.przyczepnosc,
      halas: raw.halas,
      dot: raw.dot,
      waga: raw.waga,
      labelNoise: raw.labelNoise,
      labelSnow: raw.labelSnow,
      labelIce: raw.labelIce
    });

    if (kod === 'MO6') return tyre.normalizeAgrowiec({
      ean: raw.EAN,
      rozmiar: raw.Beschreibung,
      indeksy: raw['Beschreibung 2'],
      producent: raw.Hersteller,
      stan: raw.Lagerbestand,
      cena: raw.Cena,
      model: raw.Model,
      vfIf: raw['VF/IF'],
      kategoria: raw.Kategoria
    });

    if (kod === 'MO7') return tyre.normalizeNokian({
      kodProduktu: raw['Kod produktu'],
      rozmiar: raw.Rozmiar,
      rozmiarAlternatywny: raw['Rozmiar alternatywny'],
      model: raw.MODEL,
      producent: raw.PRODUCENT,
      bieznik: raw['BIEÄąÂ»NIK'] || raw['BIEĹ»NIK'] || raw.BIEZNIK,
      sfSb: raw['SF/SB'],
      tlTt: raw['TL/TT'],
      liSi: raw['LI/SI'],
      pr: raw.PR,
      rodzaj: raw.RODZAJ,
      ean: raw.EAN,
      zakup1: raw['Zakup 1 szt'],
      magazyn: raw.Magazyn
    });

    if (kod === 'MO8') {
      const keys = Object.keys(raw);
      const bieznikKey = keys.find(k => /BIE|bie/i.test(k) && !/rozmiar/i.test(k));
      const eanKey = keys.find(k => /ean/i.test(k));
      return tyre.normalizeTrelleborg({
        rozmiar: raw.Rozmiar,
        vfIf: raw['VF/IF'],
        cfo: raw.CFO,
        rozmiarAlternatywny: raw['Rozmiar alternatywny'],
        tlTt: raw['TT/TL'] || raw['TL/TT'],
        liSi: raw['LI/SI'],
        pr: raw.PR,
        producent: raw.PRODUCENT,
        rodzaj: raw.RODZAJ || raw['RODZAJ '],
        bieznik: bieznikKey ? raw[bieznikKey] : null,
        kodProducenta: raw['Kod producenta'],
        ean: eanKey ? raw[eanKey] : null,
        cena: raw.Cena || raw['Cena '],
        magazyn: raw.Magazyn
      });
    }

    if (kod === 'MO9') return tyre.normalizeAgrorami({
      id: raw.id,
      ean: raw.ean,
      producent: raw.producent,
      bieznik: raw.bieznik,
      // POPRAWKA 2026-06-18: gdy surowa kolumna "rozmiar" jest pusta, parser MO9 (Agrorami)
      // sam juz wczesniej probowal wydobyc rozmiar z tekstu nazwy (sizeFromName) i zapisal
      // go w record.rozmiar — ale tutaj przekazywalismy tylko raw.rozmiar (pusty string),
      // wiec normalizeAgrorami nigdy nie widzial tego fallbacku i wysokosc wychodzila null,
      // mimo ze surowe.rozmiar w wyniku koncowym (przez inny fallback w adapterze) wygladal
      // poprawnie — klasyczny przypadek "podglad OK, dane strukturalne zepsute".
      rozmiar: firstValue(raw.rozmiar, record.rozmiar),
      nosnosc: raw.nosnosc,
      predkosc: raw.predkosc,
      tlTt: raw['tl/tt'],
      plotna: raw['pĹ‚otna'] || raw['płotna'] || raw.plotna,
      cena: raw.cena,
      magazyn: raw.magazyn,
      waga: raw.waga,
      kategoria: raw.kategoria,
      sezon: raw.sezon
    });

    if (kod === 'MO10') return tyre.normalizeGri({
      nrKat: raw['NR KAT'],
      ean: raw.EAN,
      bieznik: raw['Bieżnik'] || raw['BieĹĽnik'] || raw.Bieznik,
      rozmiar: raw.Rozmiar,
      ilosc: raw['ilość'] || raw['iloĹ›Ä‡'] || raw.ilosc,
      cena: raw['cena netto/szt']
    });
  } catch (e) {
    const identyfikator = firstValue(record.kod_dostawcy, record.ean, record.nazwa) || '(brak identyfikatora)';
    console.error(`[adapter] BLAD normalizacji dostawcy=${dostawcaKod} kod=${identyfikator}: ${e && e.message ? e.message : e}`);
    return null;
  }

  return null;
}

function recordToSurowe(record, dostawcaKod = record.dostawca) {
  const oz = Array.isArray(record.oznaczenia_techniczne) ? record.oznaczenia_techniczne : [];
  let enriched = normalizeBySupplier(dostawcaKod, record) || {};
  // POPRAWKA 2026-06-23: P4 (TL fallback dla ciezarowych) + Q5 (kategoria "Uzywane")
  // + ujednolicenie kategorii. Robione centralnie tutaj, zeby nie duplikowac logiki
  // w 10 funkcjach normalize* w tyre_params.cjs.
  enriched = applyPostNormalize(enriched, record);
  if (shouldRejectRecord(record, enriched)) return null;
  let kod = firstValue(enriched.kodDostawcy, record.kod_dostawcy);
  // POPRAWKA 2026-06-18: odrzucamy kod_dostawcy znieksztalcony przez notacje naukowa
  // Excela (np. "5,02E+12") — taki "kod" nie jest unikalny i nie powinien byc uzywany
  // jako identyfikator produktu. Pipeline ponizej (recordToSuroweDostawca) wygeneruje
  // wtedy stabilny syntetyczny kod z nazwy/rozmiaru zamiast tego.
  if (looksLikeMangledScientific(kod)) kod = null;
  const nazwa = firstValue(enriched.nazwaKoncowa, record.nazwa, '');

  return {
    kod: kod ? String(kod) : null,
    kodDostawcy: kod ? String(kod) : null,
    ean: firstValue(enriched.ean, record.ean),

    nazwa,
    marka: firstValue(enriched.marka, record.producent, record.marka),
    model: firstValue(enriched.model, record.model_bieznik),
    bieznik: firstValue(enriched.model, record.model_bieznik),
    kategoria: firstValue(enriched.kategoria, record.kategoria),

    magazyn: null,
    magazynRaw: null,
    stan: firstValue(enriched.stan, record.stan_magazynowy),

    cenaZakupu: firstValue(enriched.cenaZakupu, record.cena_zakupu),
    cenaSprzedazy: null,

    rozmiar: firstValue(enriched.rozmiar, record.rozmiar, record.rozmiar_alternatywny),
    rozmiarAlternatywny: firstValue(enriched.rozmiarAlternatywny, record.rozmiar_alternatywny),
    szerokosc: enriched.szerokosc ?? null,
    profil: enriched.profil ?? null,
    srednica: enriched.srednica ?? null,
    konstrukcja: enriched.konstrukcja ?? null,
    indeksNosnosci: enriched.indeksNosnosci ?? null,
