    liSi,
    result.pr ? `${result.pr}PR` : null,
    result.tlTt,
    result.ms ? 'M+S' : null,
    result.snow3pmsf ? '3PMSF' : null,
    result.sb ? 'SB' : null,  // Anna 02.07: skrót SB w nazwie
    result.dopisek
  ].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();
  return result;
}

