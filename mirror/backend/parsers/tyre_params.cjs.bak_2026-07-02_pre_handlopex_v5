    labelSnow: normalizeQty(record.labelSnow) ?? 0,
    labelIce: normalizeQty(record.labelIce) ?? 0,
    dot: emptyToNull(record.dot) || 'nie starsza niz 3 lata',
    waga: parseNumber(record.waga),
    stan: normalizeQty(record.ilosc),
