// extensions.cjs — rozszerzenia Bridge v6 dla Anny
// Dodaje endpointy:
//   POST /api/import/from-url      (body: {dostawcaKod})
//   POST /api/import/parse-file    (multipart upload pliku CSV)
// Plus scheduler auto-pull codziennie o 06:00 czasu serwera.
//
// Wszystko wchodzi przez TĘ SAMĄ FUNKCJĘ tk(dostawca, surowe) co stary flow.
// Stary endpoint /api/staging/import nie jest ruszany.

const fs = require('fs');
const os = require('os');
const path = require('path');
const https = require('https');
const http = require('http');

const dispatcher = require('./parsers/dispatcher.cjs');
const adapter = require('./parsers/adapter.cjs');
const atrybuty = require('./atrybuty_module.cjs');
const pending = require('./pending_module.cjs');

const TMP = path.join(os.tmpdir(), 'bridge_v6_imports');
if (!fs.existsSync(TMP)) fs.mkdirSync(TMP, { recursive: true });

// === Pobranie URL → bufor ===
function downloadUrl(url) {
  return new Promise((resolve, reject) => {
    const mod = url.startsWith('https') ? https : http;
    const req = mod.get(url, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        // proste obsłużenie 3xx redirect
        downloadUrl(res.headers.location).then(resolve, reject);
        return;
      }
      if (res.statusCode !== 200) {
        reject(new Error(`HTTP ${res.statusCode} dla ${url}`));
        return;
      }
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => resolve(Buffer.concat(chunks)));
      res.on('error', reject);
    });
    req.on('error', reject);
    req.setTimeout(60000, () => req.destroy(new Error(`Timeout: ${url}`)));
  });
}

function saveTmp(buf, name) {
  const filePath = path.join(TMP, name);
  fs.writeFileSync(filePath, buf);
  return filePath;
}

// === Główna ścieżka: file path → surowe gotowe dla tk() ===
function parseAndConvert(dostawcaKod, filePath) {
  const result = dispatcher.parseByKod(dostawcaKod, filePath);
  const surowe = adapter.recordsToSurowe(dostawcaKod, result.records);
  return {
    surowe,
    errors: result.errors || [],
    odrzucone: result.odrzucone || [],
    recordsCount: result.records.length
  };
}

// === Rejestracja endpointów ===
// Wywoływane z index.cjs przez require('./extensions.cjs').register(app, ctx)
// ctx zawiera referencje do funkcji backendu które potrzebujemy: tk, U (DB), we (auth middleware), be (audit log)
// === Helper: URL i częstotliwość per dostawca z DB ===
// Preferuje wartości z tabeli suppliers, fallback do dispatcher.URLS.
function getSupplierUrlFromDb(U, kod) {
  try {
    const s = U.getSupplierByKod(kod);
    if (s && typeof s.url === 'string' && s.url.trim().length > 0) return s.url.trim();
  } catch (_) {}
  return null;
}
function resolveUrl(U, kod) {
  return getSupplierUrlFromDb(U, kod) || dispatcher.getUrl(kod);
}
function getSupplierMinutesFromDb(U, kod) {
  try {
    const s = U.getSupplierByKod(kod);
    if (s) {
      const m = s.czestotliwosc_minuty ?? s.czestotliwoscMinuty;
      if (m !== null && m !== undefined && Number.isFinite(Number(m)) && Number(m) > 0) return Number(m);
    }
  } catch (_) {}
  return null;
}

function register(app, ctx) {
  const { tk, U, we, be } = ctx;

  if (!tk || !U || !we || !be) {
    console.error('[bridge_v6] BŁĄD: brakuje ctx (tk/U/we/be) — extensions nie zostały zarejestrowane');
    return;
  }

  // === MODUŁ ATRYBUTÓW ===
  try {
    atrybuty.registerAtrybuty(app, { we, be });
  } catch (e) {
    console.error('[bridge_v6] BŁĄD ładowania modułu atrybutów:', e.message);
  }

  // === MODUŁ PENDING (Faza B) ===
  try {
    pending.registerPending(app, { we, be });
  } catch (e) {
    console.error('[bridge_v6] BŁĄD ładowania modułu pending:', e.message);
  }

  // === POST /api/import/from-url ===
  // Body: { dostawcaKod: "MO10" }
  // Pobiera plik z URL dostawcy, parsuje, woła tk(), zapisuje staging
  app.post('/api/import/from-url', we, async (req, res) => {
    const dostawcaKod = (req.body?.dostawcaKod || req.body?.dostawca || '').toUpperCase();
    if (!dostawcaKod) return res.status(400).json({ error: 'Brak dostawcaKod' });

    const url = resolveUrl(U, dostawcaKod);
    if (!url) return res.status(400).json({ error: `Brak URL dla dostawcy ${dostawcaKod}` });

    try {
      console.log(`[bridge_v6] from-url ${dostawcaKod} ← ${url}`);
      const buf = await downloadUrl(url);
      const filePath = saveTmp(buf, `${dostawcaKod}_${Date.now()}.csv`);

      const { surowe, errors, odrzucone, recordsCount } = parseAndConvert(dostawcaKod, filePath);
      const tkResult = tk(dostawcaKod, surowe);

      // Audit log
      try {
        const dostawca = U.getSupplierByKod(dostawcaKod);
        if (dostawca) {
          U.updateSupplier(dostawca.id, {
            ostatniPlik: new Date().toISOString(),
            liczbaProduktow: recordsCount,
            status: 'aktywny'
          });
        }
        be(req.user.id, req.user.imieNazwisko, 'import_z_url', 'dostawca', dostawcaKod, {
          source: 'from-url',
          url,
          wczytanych: recordsCount,
          parserErrors: errors.length,
          odrzucone: odrzucone.length,
          ...tkResult
        });
      } catch (e) {
        console.error('[bridge_v6] audit log fail:', e.message);
      }

      res.json({
        ok: true,
        dostawcaKod,
        url,
        wczytanych: recordsCount,
        parserErrors: errors.length,
        odrzuconePrzezParser: odrzucone.length,
        ...tkResult
      });

      // Czyszczenie tmp
      try { fs.unlinkSync(filePath); } catch (_) {}
    } catch (e) {
      console.error(`[bridge_v6] from-url ${dostawcaKod} BŁĄD:`, e);
      res.status(500).json({ error: e.message, dostawcaKod, url });
    }
  });

  // === POST /api/import/parse-file ===
  // Multipart upload pliku CSV (pole 'file', dostawcaKod w body lub auto-detekcja po nazwie)
  // Marta używa tego z drag&drop w panelu
  //
  // UWAGA: multipart wymaga middleware. Sprawdzamy czy multer jest dostępny,
  // jeśli nie — fallback: przyjmujemy raw body jako CSV gdy Content-Type to text/csv lub application/octet-stream
  app.post('/api/import/parse-file', we, async (req, res) => {
    const dostawcaKod = (req.query?.dostawcaKod || req.body?.dostawcaKod || '').toUpperCase();
    if (!dostawcaKod) return res.status(400).json({ error: 'Brak dostawcaKod (query lub body)' });

    if (!resolveUrl(U, dostawcaKod)) {
      return res.status(400).json({ error: `Nieznany dostawca: ${dostawcaKod}` });
    }

    try {
      // Czytamy raw body (req jest stream)
      const chunks = [];
      for await (const c of req) chunks.push(c);
      const buf = Buffer.concat(chunks);

      if (buf.length === 0) return res.status(400).json({ error: 'Pusty plik' });
      if (buf.length > 25 * 1024 * 1024) return res.status(400).json({ error: 'Plik większy niż 25 MB' });

      const filePath = saveTmp(buf, `${dostawcaKod}_upload_${Date.now()}.csv`);
      const { surowe, errors, odrzucone, recordsCount } = parseAndConvert(dostawcaKod, filePath);
      const tkResult = tk(dostawcaKod, surowe);

      try {
        const dostawca = U.getSupplierByKod(dostawcaKod);
        if (dostawca) {
          U.updateSupplier(dostawca.id, {
            ostatniPlik: new Date().toISOString(),
            liczbaProduktow: recordsCount,
            status: 'aktywny'
          });
        }
        be(req.user.id, req.user.imieNazwisko, 'import_pliku', 'dostawca', dostawcaKod, {
          source: 'parse-file',
          wczytanych: recordsCount,
          parserErrors: errors.length,
          odrzucone: odrzucone.length,
          ...tkResult
        });
      } catch (e) {
        console.error('[bridge_v6] audit log fail:', e.message);
      }

      res.json({
        ok: true,
        dostawcaKod,
        wczytanych: recordsCount,
        parserErrors: errors.length,
        odrzuconePrzezParser: odrzucone.length,
        ...tkResult
      });

      try { fs.unlinkSync(filePath); } catch (_) {}
    } catch (e) {
      console.error(`[bridge_v6] parse-file ${dostawcaKod} BŁĄD:`, e);
      res.status(500).json({ error: e.message, dostawcaKod });
    }
  });

  // === GET /admin/import-now ===
  // Prosta strona admina: lista dostawców z przyciskiem "Pobierz teraz".
  // Logowanie używa /api/login (zwraca token JWT — zapisujemy w localStorage).
  app.get('/admin/import-now', (req, res) => {
    res.setHeader('Content-Type', 'text/html; charset=utf-8');
    res.send(IMPORT_NOW_HTML);
  });

  // === GET /api/admin/suppliers-list ===
  // Zwraca listę dostawców + URL z dispatchera + status z bazy. Dla strony import-now.
  app.get('/api/admin/suppliers-list', we, (req, res) => {
    try {
      const wszyscy = U.listSuppliers();
      const out = dispatcher.listDostawcy().map(kod => {
        const supplier = wszyscy.find(s => s.kod === kod) || {};
        return {
          kod,
          nazwa: supplier.nazwa || kod,
          url: resolveUrl(U, kod),
          czestotliwoscMinuty: supplier.czestotliwosc_minuty ?? supplier.czestotliwoscMinuty ?? null,
          status: supplier.status || 'aktywny',
          ostatniPlik: supplier.ostatni_plik || supplier.ostatniPlik || null,
          liczbaProduktow: supplier.liczba_produktow || supplier.liczbaProduktow || 0
        };
      });
      res.json({ ok: true, dostawcy: out });
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  // === GET /api/admin/supplier-config ===
  // Zwraca listę wszystkich dostawców z ich URL i częstotliwością (do formularza edycji)
  app.get('/api/admin/supplier-config', we, (req, res) => {
    try {
      const out = dispatcher.listDostawcy().map(kod => {
        const s = U.getSupplierByKod(kod) || {};
        return {
          kod,
          nazwa: s.nazwa || kod,
          url: (s.url && s.url.trim().length > 0) ? s.url : dispatcher.getUrl(kod),
          urlEfektywnyZDb: !!(s.url && s.url.trim().length > 0),
          czestotliwoscMinuty: s.czestotliwosc_minuty ?? s.czestotliwoscMinuty ?? null,
          status: s.status || 'aktywny',
          fallbackUrl: dispatcher.getUrl(kod)
        };
      });
      res.json({ ok: true, dostawcy: out });
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  // === PATCH /api/admin/supplier-config/:kod ===
  // Body: { url?: string, czestotliwoscMinuty?: number|null, status?: 'aktywny'|'wstrzymany' }
  // Aktualizuje pola dostawcy w tabeli suppliers.
  app.patch('/api/admin/supplier-config/:kod', we, (req, res) => {
    const kod = String(req.params.kod || '').toUpperCase();
    if (!dispatcher.listDostawcy().includes(kod)) {
      return res.status(400).json({ error: `Nieznany dostawca: ${kod}` });
    }
    const supplier = U.getSupplierByKod(kod);
    if (!supplier) return res.status(404).json({ error: `Dostawca ${kod} nie istnieje w bazie` });

    const patch = {};
    if (Object.prototype.hasOwnProperty.call(req.body || {}, 'url')) {
      const v = req.body.url;
      if (v === null || v === '') {
        patch.url = null;
      } else if (typeof v === 'string' && /^https?:\/\//i.test(v.trim())) {
        patch.url = v.trim();
      } else {
        return res.status(400).json({ error: 'url musi być http(s):// albo null/pusty' });
      }
    }
    if (Object.prototype.hasOwnProperty.call(req.body || {}, 'czestotliwoscMinuty')) {
      const v = req.body.czestotliwoscMinuty;
      if (v === null || v === '' || v === undefined) {
        patch.czestotliwoscMinuty = null;
      } else {
        const n = Number(v);
        if (!Number.isFinite(n) || n < 5 || n > 10080) {
          return res.status(400).json({ error: 'czestotliwoscMinuty: 5..10080 albo null' });
        }
        patch.czestotliwoscMinuty = Math.round(n);
      }
    }
    if (Object.prototype.hasOwnProperty.call(req.body || {}, 'status')) {
      const v = String(req.body.status || '').toLowerCase();
      if (!['aktywny', 'wstrzymany', 'blad'].includes(v)) {
        return res.status(400).json({ error: 'status: aktywny|wstrzymany|blad' });
      }
      patch.status = v;
    }

    if (Object.keys(patch).length === 0) {
      return res.status(400).json({ error: 'Brak pól do aktualizacji (url|czestotliwoscMinuty|status)' });
    }

    try {
      U.updateSupplier(supplier.id, patch);
      // Reset last-run żeby nowa częstotliwość od razu obowiązywała
      if (Object.prototype.hasOwnProperty.call(patch, 'czestotliwoscMinuty')) {
        delete lastRunPerSupplier[kod];
      }
      be(req.user.id, req.user.imieNazwisko, 'edit_supplier_config', 'dostawca', kod, {
        pola: Object.keys(patch),
        nowe: patch
      });
      const updated = U.getSupplierByKod(kod);
      res.json({
        ok: true,
        kod,
        url: updated.url,
        czestotliwoscMinuty: updated.czestotliwosc_minuty ?? updated.czestotliwoscMinuty ?? null,
        status: updated.status
      });
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  // === GET /admin/supplier-config ===
  // Prosty admin page z formularzem edycji URL + częstotliwość per dostawca.
  app.get('/admin/supplier-config', (req, res) => {
    res.setHeader('Content-Type', 'text/html; charset=utf-8');
    res.send(SUPPLIER_CONFIG_HTML);
  });

  // === Scheduler: per-supplier auto-pull ===
  startScheduler(app, ctx);

  console.log('[bridge_v6] Extensions registered: /api/import/from-url, /api/import/parse-file, /admin/import-now, /admin/supplier-config, scheduler per-supplier');

  // === Fix E + Fix J: rejestracja modulow analityki i paginacji ===
  // Otwieram drugi handle do tej samej bazy (better-sqlite3 obsluguje wiele handle'i)
  let _bridgeDb = null;
  try {
    const Database = require('better-sqlite3');
    const path = require('path');
    _bridgeDb = new Database(path.join(__dirname, 'data.db'), { readonly: false });
  } catch (e) {
    console.error('[bridge_v6] BLAD otwarcia data.db dla analytics/pagination:', e.message);
  }
  if (_bridgeDb) {
    try {
      const { registerAnalyticsRoutes } = require('./analytics_module.cjs');
      registerAnalyticsRoutes(app, _bridgeDb, we);
      console.log('[bridge_v6] Fix E: /api/analytics/* zarejestrowane');
    } catch (e) {
      console.error('[bridge_v6] BLAD ladowania analytics_module:', e.message);
    }
    try {
      const { registerPaginationRoutes } = require('./pagination_module.cjs');
      registerPaginationRoutes(app, _bridgeDb, we);
      console.log('[bridge_v6] Fix J: /api/staging/paged i /api/history/* zarejestrowane');
    } catch (e) {
      console.error('[bridge_v6] BLAD ladowania pagination_module:', e.message);
    }
  }
}

