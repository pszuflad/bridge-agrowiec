<script>
const TOKEN_KEY = 'bridge_token';
const USER_KEY = 'bridge_user';

function getToken() { return localStorage.getItem(TOKEN_KEY); }
function getUser() { try { return JSON.parse(localStorage.getItem(USER_KEY)); } catch(_){ return null; } }
function setAuth(t, u) { localStorage.setItem(TOKEN_KEY, t); localStorage.setItem(USER_KEY, JSON.stringify(u)); }
function clearAuth() { localStorage.removeItem(TOKEN_KEY); localStorage.removeItem(USER_KEY); }

async function api(method, path, body) {
  const opts = { method, headers: { 'Content-Type': 'application/json' } };
  const t = getToken();
  if (t) opts.headers['Authorization'] = 'Bearer ' + t;
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(path, opts);
  const txt = await res.text();
  let json; try { json = JSON.parse(txt); } catch(_){ json = { error: txt }; }
  return { ok: res.ok, status: res.status, json };
}

function fmtDate(iso) {
  if (!iso) return '—';
  try { return new Date(iso).toLocaleString('pl-PL', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }); } catch(_) { return iso; }
}

function showLogin() {
  document.getElementById('login-box').classList.remove('hidden');
  document.getElementById('panel').classList.add('hidden');
}
function showPanel() {
  document.getElementById('login-box').classList.add('hidden');
  document.getElementById('panel').classList.remove('hidden');
  const u = getUser();
  document.getElementById('who').textContent = u ? (u.imieNazwisko + ' (' + u.email + ')') : '';
  loadList();
}

async function login() {
  const email = document.getElementById('email').value.trim();
  const password = document.getElementById('password').value;
  const err = document.getElementById('login-err');
  err.className = 'result'; err.textContent = '';
  if (!email || !password) { err.className='result err'; err.textContent='Podaj email i hasło'; return; }
  const r = await api('POST', '/api/login', { email, password });
  if (!r.ok || !r.json.token) { err.className='result err'; err.textContent = r.json.error || 'Błąd logowania'; return; }
  setAuth(r.json.token, r.json.user);
  showPanel();
}

async function loadList() {
  const list = document.getElementById('list');
  list.innerHTML = 'Ładowanie...';
  const r = await api('GET', '/api/admin/suppliers-list');
  if (!r.ok) {
    if (r.status === 401) { clearAuth(); showLogin(); return; }
    list.textContent = 'Błąd: ' + (r.json.error || r.status);
    return;
  }
  list.innerHTML = '';
  for (const d of r.json.dostawcy) {
    const row = document.createElement('div');
    row.className = 'row';
    row.innerHTML = \`
      <div class="row-info">
        <div class="kod">\${d.kod} — \${d.nazwa}</div>
        <div class="url">\${d.url}</div>
        <div class="result" id="res-\${d.kod}"></div>
      </div>
      <div class="meta">
        Ostatnio: \${fmtDate(d.ostatniPlik)}<br>
        Produktów: \${d.liczbaProduktow}
      </div>
      <button data-kod="\${d.kod}" class="import-btn">Pobierz teraz</button>
    \`;
    list.appendChild(row);
  }
  document.querySelectorAll('.import-btn').forEach(b => {
    b.addEventListener('click', () => importOne(b.dataset.kod, b));
  });
}

async function importOne(kod, btn) {
  const res = document.getElementById('res-' + kod);
  res.className = 'result'; res.textContent = '';
  if (btn) { btn.disabled = true; btn.textContent = 'Pobieram...'; }
  const r = await api('POST', '/api/import/from-url', { dostawcaKod: kod });
  if (btn) { btn.disabled = false; btn.textContent = 'Pobierz teraz'; }
  if (!r.ok) {
    if (r.status === 401) { clearAuth(); showLogin(); return; }
    res.className = 'result err';
    res.textContent = 'Błąd: ' + (r.json.error || r.status);
    return;
  }
  const d = r.json;
  res.className = 'result ok';
  res.textContent = \`OK — wczytanych: \${d.wczytanych}, do stagingu: \${d.doStagingu}, nowe: \${d.nowe}, zmiany: \${d.zmienione}, wycofane: \${d.wycofane}\`;
  // Odśwież listę zeby zaktualizować 'ostatniPlik'
  setTimeout(loadList, 1500);
}

async function pullAll() {
  const btn = document.getElementById('pull-all-btn');
  const status = document.getElementById('pull-all-status');
  btn.disabled = true;
  const r = await api('GET', '/api/admin/suppliers-list');
  if (!r.ok) { btn.disabled = false; return; }
  let done = 0;
  for (const d of r.json.dostawcy) {
    status.textContent = \`\${done+1}/\${r.json.dostawcy.length}: \${d.kod}...\`;
    await importOne(d.kod, null);
    done++;
  }
  status.textContent = 'Gotowe: pobrano ' + done + ' dostawców';
  btn.disabled = false;
  loadList();
}

