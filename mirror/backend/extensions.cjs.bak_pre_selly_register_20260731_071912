// === Scheduler ===
let schedulerStarted = false;
// Per-supplier: last-run timestamp (ms since epoch) w pamięci.
// Nie zapisujemy do DB — restart backendu = reset kalendarza (uznałam, że OK).
const lastRunPerSupplier = {};

function startScheduler(app, ctx) {
  if (schedulerStarted) return;
  schedulerStarted = true;

  const { tk, U, be } = ctx;

  // Co 60 sek: sprawdzam każdego dostawcę osobno.
  // Jeśli ma czestotliwosc_minuty i minęło od ostatniego runu — odpalam.
  // Jeśli brak czestotliwosc_minuty — pomijam (ręczny import przez UI).
  // Domyślne dolne ograniczenie: 5 min (chroni przed konfiguracją typu „co 1 min”).
  setInterval(async () => {
    const now = Date.now();
    for (const kod of dispatcher.listDostawcy()) {
      const minuty = getSupplierMinutesFromDb(U, kod);
      if (!minuty) continue; // dostawca bez skonfigurowanej częstotliwości = tylko manual
      const minMinutes = 5;
      const effectiveMinutes = Math.max(minuty, minMinutes);
      const last = lastRunPerSupplier[kod] || 0;
      if (now - last < effectiveMinutes * 60 * 1000) continue;
      lastRunPerSupplier[kod] = now;
      // Odpalamy niezablokowanie — nie czekamy na dostawcę, żeby pętla nie stała.
      runAutoPull(ctx, kod).catch(err => {
        console.error(`[bridge_v6] scheduler ${kod} BLAD:`, err.message);
      });
    }
  }, 60 * 1000);

  console.log('[bridge_v6] Scheduler started: per-supplier polling wg czestotliwosc_minuty (co 60s tick, min 5 min)');
}

async function runAutoPull(ctx, onlyKod) {
  const { tk, U, be } = ctx;
  const kody = onlyKod
    ? [String(onlyKod).toUpperCase()].filter(k => dispatcher.listDostawcy().includes(k))
    : dispatcher.listDostawcy();
  if (!onlyKod) console.log('[bridge_v6] AUTO-PULL START (wszyscy)');

  for (const dostawcaKod of kody) {
    const url = resolveUrl(U, dostawcaKod);
    if (!url) {
      console.error(`[bridge_v6] AUTO-PULL ${dostawcaKod}: brak URL — pomijam`);
      continue;
    }
    try {
      const buf = await downloadUrl(url);
      const filePath = saveTmp(buf, `${dostawcaKod}_auto_${Date.now()}.csv`);
      const { surowe, errors, odrzucone, recordsCount } = parseAndConvert(dostawcaKod, filePath);
      const tkResult = tk(dostawcaKod, surowe);

      try {
        const dostawca = U.getSupplierByKod(dostawcaKod);
        if (dostawca) {
          U.updateSupplier(dostawca.id, {
            ostatniPlik: new Date().toISOString(),
            liczbaProduktow: recordsCount,
            status: 'aktywny'
          });
        }
        // System user: id=0, imieNazwisko='SYSTEM-AUTOPULL'
        be(0, 'SYSTEM-AUTOPULL', 'auto_pull', 'dostawca', dostawcaKod, {
          source: 'scheduler',
          url,
          wczytanych: recordsCount,
          parserErrors: errors.length,
          odrzucone: odrzucone.length,
          ...tkResult
        });
      } catch (e) {
        console.error(`[bridge_v6] audit fail ${dostawcaKod}:`, e.message);
      }

      console.log(`[bridge_v6] AUTO-PULL ${dostawcaKod}: ${recordsCount} wierszy, ${tkResult.doStagingu} do stagingu`);

      try { fs.unlinkSync(filePath); } catch (_) {}
    } catch (e) {
      console.error(`[bridge_v6] AUTO-PULL ${dostawcaKod} BŁĄD:`, e.message);
      try {
        be(0, 'SYSTEM-AUTOPULL', 'auto_pull_blad', 'dostawca', dostawcaKod, {
          error: e.message,
          url
        });
      } catch (_) {}
    }
  }
  if (!onlyKod) console.log('[bridge_v6] AUTO-PULL END');
}

