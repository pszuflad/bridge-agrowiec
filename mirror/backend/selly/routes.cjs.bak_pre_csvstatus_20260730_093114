// backend/selly/routes.cjs
// Endpointy REST integracji Selly.pl dla Bridge dla Agrowca.
//
// Rejestracja w backend/index.cjs (na końcu, po istniejących trasach):
//   const registerSellyRoutes = require('./selly/routes.cjs');
//   registerSellyRoutes(app, { db, requireAuth, auditLog });
//
// Endpointy:
//   GET  /api/selly/ping                               - test tokenu i połączenia
//   GET  /api/selly/dictionaries?force=1               - słowniki Selly (mapy id-ków)
//   POST /api/selly/producers   {name}                 - dodaj markę do Selly
//   POST /api/selly/categories  {name, parent_id}      - dodaj kategorię do Selly
//   POST /api/selly/sync-product {kod}                 - zsync 1 produkt (create/update)
//   POST /api/selly/sync-supplier {dostawca, dry_run?, limit?}  - zsync wszystkie produkty dostawcy
//   GET  /api/selly/status?dostawca=MO1                - status mapowania (ile już zsynchronizowano)
//   GET  /api/selly/log?limit=20                       - historia operacji

'use strict';

const client = require('./client.cjs');
const { toSellyPayload, validatePayload } = require('./mapper.cjs');

// ---- Helpery cache słowników ----

async function refreshDict(db) {
  const now = new Date().toISOString();
  const upsert = db.prepare(`
    INSERT INTO selly_dict (slownik, klucz, wartosc_id, raw_json, odswiezono)
    VALUES (?, ?, ?, ?, ?)
    ON CONFLICT(slownik, klucz) DO UPDATE SET
      wartosc_id = excluded.wartosc_id,
      raw_json   = excluded.raw_json,
      odswiezono = excluded.odswiezono
  `);
  const clear = db.prepare('DELETE FROM selly_dict WHERE slownik = ?');

  // Producers (max 50 per page — Selly limit)
  const prod = await client.listProducers({ limit: 50 });
  clear.run('producers');
  for (const p of (prod?.data || [])) {
    upsert.run('producers', (p.name || '').trim().toLowerCase(), p.producer_id, JSON.stringify(p), now);
  }
  // Categories
  const cat = await client.listCategories({ limit: 50 });
  clear.run('categories');
  for (const c of (cat?.data || [])) {
    upsert.run('categories', (c.name || '').trim().toLowerCase(), c.category_id, JSON.stringify(c), now);
  }
  // VAT
  const vat = await client.listVatRates();
  clear.run('vat_rates');
  for (const v of (vat?.data || [])) {
    upsert.run('vat_rates', String(v.rate), v.vat_id || 0, JSON.stringify(v), now);
  }
  // Warehouses
  const wh = await client.listWarehouses();
  clear.run('warehouses');
  for (const w of (wh?.data || [])) {
    upsert.run('warehouses', (w.name || '').trim().toLowerCase(), w.warehouse_id, JSON.stringify(w), now);
  }
}

function loadMaps(db) {
  const rows = db.prepare('SELECT slownik, klucz, wartosc_id FROM selly_dict').all();
  const maps = { producerMap: {}, catMap: {}, vatMap: {}, whMap: {} };
  for (const r of rows) {
    if (r.slownik === 'producers')  maps.producerMap[r.klucz] = r.wartosc_id;
    if (r.slownik === 'categories') maps.catMap[r.klucz]      = r.wartosc_id;
    if (r.slownik === 'vat_rates')  maps.vatMap[r.klucz]      = r.wartosc_id;
    if (r.slownik === 'warehouses') maps.whMap[r.klucz]       = r.wartosc_id;
  }
  return maps;
}

async function ensureDict(db, force = false) {
  const count = db.prepare('SELECT COUNT(*) AS n FROM selly_dict').get().n;
  if (force || count === 0) await refreshDict(db);
  return loadMaps(db);
}

// ---- Główna rejestracja tras ----

function registerSellyRoutes(app, { db, requireAuth, auditLog }) {
  // Wrapper - jeśli middleware auth nie dostępny, przepuść (np. w skryptach test)
  const auth = requireAuth || ((c, u, n) => n());
  const audit = auditLog || (() => {});

  // ---- Diagnostyka ----
  app.get('/api/selly/ping', auth, async (req, res) => {
    try {
      const info = await client.ping();
      res.json(info);
    } catch (e) {
      res.status(500).json({ ok: false, error: e.message });
    }
  });

  // ---- Słowniki ----
  app.get('/api/selly/dictionaries', auth, async (req, res) => {
    try {
      const force = req.query.force === '1' || req.query.force === 'true';
      const maps = await ensureDict(db, force);
      res.json({
        producers:  maps.producerMap,
        categories: maps.catMap,
        vat_rates:  maps.vatMap,
        warehouses: maps.whMap,
        refreshed:  force,
      });
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  app.post('/api/selly/producers', auth, async (req, res) => {
    try {
      const { name } = req.body || {};
      if (!name) return res.status(400).json({ error: 'Brak name' });
      const r = await client.createProducer({ name });
      await refreshDict(db);
      audit(req.user?.id, req.user?.imieNazwisko, 'selly_dodanie_producenta', 'selly_producer', name, r);
      res.json(r);
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  app.post('/api/selly/categories', auth, async (req, res) => {
    try {
      const { name, parent_id = 0, visible = 'sklep' } = req.body || {};
      if (!name) return res.status(400).json({ error: 'Brak name' });
      const r = await client.createCategory({ name, parent_id, visible });
      await refreshDict(db);
      audit(req.user?.id, req.user?.imieNazwisko, 'selly_dodanie_kategorii', 'selly_category', name, r);
      res.json(r);
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  // ---- Sync pojedynczego produktu ----
  app.post('/api/selly/sync-product', auth, async (req, res) => {
    try {
      const { kod } = req.body || {};
      if (!kod) return res.status(400).json({ error: 'Brak "kod"' });

      const row = db.prepare('SELECT * FROM products WHERE kod = ?').get(kod);
      if (!row) return res.status(404).json({ error: `Nie znaleziono produktu ${kod}` });
      if (row.status !== 'aktywny') {
        return res.status(400).json({ error: `Produkt ${kod} ma status "${row.status}" — nie może być wysłany do Selly` });
      }

      const maps = await ensureDict(db);
      const payload = toSellyPayload(row, maps, { db });
      const val = validatePayload(payload);
      if (!val.ok) return res.status(400).json({ error: 'Walidacja', details: val.errors, payload });

      const result = await syncOneProduct(db, row, payload);
      audit(req.user?.id, req.user?.imieNazwisko, 'selly_sync_produktu', 'produkt', kod, result);
      res.json(result);
    } catch (e) {
      res.status(500).json({ error: e.message, stack: e.stack });
    }
  });

  // ---- Sync całego dostawcy ----
  app.post('/api/selly/sync-supplier', auth, async (req, res) => {
    const {
      dostawca,
      dry_run = false,
      limit   = 0,       // 0 = wszystkie
      only_updated = false, // true = tylko produkty zmienione od ostatniego sync
    } = req.body || {};

    if (!dostawca) return res.status(400).json({ error: 'Brak "dostawca" (np. "MO1")' });

    // Rejestrujemy w logu (pending)
    const logIns = db.prepare(`
      INSERT INTO selly_sync_log (operacja, dostawca_kod, uzytkownik_id, uzytkownik_imie, status)
      VALUES ('sync_supplier', ?, ?, ?, 'w_trakcie')
    `).run(dostawca, req.user?.id || null, req.user?.imieNazwisko || null);
    const logId = logIns.lastInsertRowid;

    try {
      const maps = await ensureDict(db);

      let sqlSelect = `
        SELECT p.* FROM products p
        LEFT JOIN selly_products sp ON sp.bridge_kod = p.kod
        WHERE p.dostawca = ? AND p.status = 'aktywny'
      `;
      const params = [dostawca];
      if (only_updated) {
        sqlSelect += ' AND (sp.bridge_kod IS NULL OR p.data_aktualizacji > sp.ostatnia_sync)';
      }
      if (limit && limit > 0) sqlSelect += ` LIMIT ${parseInt(limit,10)}`;

      const rows = db.prepare(sqlSelect).all(...params);

      let created = 0, updated = 0, failed = 0, skipped = 0;
      const errors = [];
      const dryPayloads = [];

      for (const row of rows) {
        const payload = toSellyPayload(row, maps, { db });
        const val = validatePayload(payload);
        if (!val.ok) {
          skipped++;
          errors.push({ kod: row.kod, reason: val.errors.join('; ') });
          continue;
        }
        if (dry_run) {
          if (dryPayloads.length < 5) dryPayloads.push({ kod: row.kod, payload });
          continue;
        }
        try {
          const r = await syncOneProduct(db, row, payload);
          if (r.action === 'created') created++;
          else if (r.action === 'updated') updated++;
        } catch (e) {
          failed++;
          errors.push({ kod: row.kod, error: e.message.slice(0, 250) });
        }
      }

      const summary = {
        dostawca,
        total: rows.length,
        created, updated, failed, skipped,
        dry_run,
        errors: errors.slice(0, 50),
        dry_payloads: dry_run ? dryPayloads : undefined,
      };

      db.prepare(`
        UPDATE selly_sync_log
        SET liczba_ok = ?, liczba_blad = ?, liczba_skip = ?,
            szczegoly_json = ?, zakonczono = datetime('now'), status = 'zakonczono'
        WHERE id = ?
      `).run(created + updated, failed, skipped, JSON.stringify(summary), logId);

      audit(req.user?.id, req.user?.imieNazwisko, 'selly_sync_dostawcy', 'dostawca', dostawca, summary);
      res.json(summary);
    } catch (e) {
      db.prepare(`UPDATE selly_sync_log SET status='blad', zakonczono=datetime('now'), szczegoly_json=? WHERE id=?`)
        .run(JSON.stringify({ error: e.message }), logId);
      res.status(500).json({ error: e.message });
    }
  });

  // ---- Status ----
  app.get('/api/selly/status', auth, (req, res) => {
    try {
      const { dostawca } = req.query;
      const stmt = dostawca
        ? db.prepare(`
            SELECT p.dostawca,
                   COUNT(*) AS w_bridge,
                   SUM(CASE WHEN sp.id IS NOT NULL THEN 1 ELSE 0 END) AS w_selly,
                   SUM(CASE WHEN sp.ostatni_status='error' THEN 1 ELSE 0 END) AS z_bledami
            FROM products p LEFT JOIN selly_products sp ON sp.bridge_kod = p.kod
            WHERE p.dostawca = ? AND p.status='aktywny'
            GROUP BY p.dostawca
          `)
        : db.prepare(`
            SELECT p.dostawca,
                   COUNT(*) AS w_bridge,
                   SUM(CASE WHEN sp.id IS NOT NULL THEN 1 ELSE 0 END) AS w_selly,
                   SUM(CASE WHEN sp.ostatni_status='error' THEN 1 ELSE 0 END) AS z_bledami
            FROM products p LEFT JOIN selly_products sp ON sp.bridge_kod = p.kod
            WHERE p.status='aktywny'
            GROUP BY p.dostawca
            ORDER BY p.dostawca
          `);
      const rows = dostawca ? stmt.all(dostawca) : stmt.all();
      res.json({ items: rows });
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  // ---- Log ----
  app.get('/api/selly/log', auth, (req, res) => {
    try {
      const limit = Math.min(parseInt(req.query.limit) || 20, 200);
      const rows = db.prepare(`
        SELECT * FROM selly_sync_log ORDER BY rozpoczeto DESC LIMIT ?
      `).all(limit);
      res.json({ items: rows });
    } catch (e) {
      res.status(500).json({ error: e.message });
    }
  });

  console.log('[Selly] Zarejestrowano endpointy /api/selly/*');
}

// ---- Wewnętrzny helper: sync jednego produktu ----

async function syncOneProduct(db, row, payload) {
  const existing = db.prepare('SELECT * FROM selly_products WHERE bridge_kod = ?').get(row.kod);

  if (existing) {
    // UPDATE
    await client.updateProduct(existing.selly_product_id, payload);
    await client.upsertProductWarehouse(existing.selly_product_id, {
      warehouse_id: payload.warehouse_id,
      quantity: Number(row.stan) || 0,
    });
    if (payload._extra_cat_ids && payload._extra_cat_ids.length) {
      await client.setProductMultiCat(existing.selly_product_id, payload._extra_cat_ids)
        .catch(e => console.warn(`[Selly] multi_cat update ${row.kod}:`, e.message));
    }
    db.prepare(`
      UPDATE selly_products SET
        ostatnia_sync = datetime('now'),
        ostatni_status = 'ok',
        ostatni_blad = NULL,
        selly_category_id = ?,
        selly_producer_id = ?,
        cena_sprzedazy_wyslana = ?,
        cena_zakupu_wyslana = ?,
        stan_wyslany = ?
      WHERE id = ?
    `).run(payload.category_id, payload.producer_id, payload.price, payload.price_purchase, row.stan, existing.id);
    return { action: 'updated', kod: row.kod, selly_product_id: existing.selly_product_id };
  }

  // CREATE
  const created = await client.createProduct(payload);
  const productId = created?.data?.product_id;
  if (!productId) throw new Error('Brak product_id w odpowiedzi Selly: ' + JSON.stringify(created).slice(0, 200));
  await client.upsertProductWarehouse(productId, {
    warehouse_id: payload.warehouse_id,
    quantity: Number(row.stan) || 0,
  });
  if (payload._extra_cat_ids && payload._extra_cat_ids.length) {
    await client.setProductMultiCat(productId, payload._extra_cat_ids)
      .catch(e => console.warn(`[Selly] multi_cat create ${row.kod}:`, e.message));
  }
  db.prepare(`
    INSERT INTO selly_products (bridge_kod, selly_product_id, selly_category_id, selly_producer_id,
      cena_sprzedazy_wyslana, cena_zakupu_wyslana, stan_wyslany, ostatnia_sync, ostatni_status)
    VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'), 'ok')
  `).run(row.kod, productId, payload.category_id, payload.producer_id,
         payload.price, payload.price_purchase, row.stan);
  return { action: 'created', kod: row.kod, selly_product_id: productId };
}

module.exports = registerSellyRoutes;
