// selly/sync_full.cjs
// TOR 2: pelny sync produktow Bridge -> Selly (nocny lub reczny).
// Model: bridge (kod_importu, dostawca) -> selly (product_id, variant_id).
//
// Aktualizuje:
//   - pola produktu: name, weight, ean, provider_code, price_purchase, visible
//   - features (21 atrybutow) na wariancie w trybie mirror (nie kasuje istniejacych)
//   - cena_zakupu na produkcie (price_purchase)
// NIE aktualizuje:
//   - VAT (Anna 2026-09-08: nadawany w Selly na kategorii)
//   - price (aktualizuje sync_delta co interval)
//   - stan (aktualizuje sync_delta co interval)
//   - kategoria/producent (dopisujemy tylko przy tworzeniu nowego produktu)
//
// 3 sciezki per rekord:
//   A. Wariant istnieje w cache -> PUT /api/products/{pid} (produkt) + PUT variants/{vid} (features)
//   B. Produkt w Selly istnieje, wariantu brak -> disc.createVariant + PUT produkt
//   C. Produkt nie istnieje -> disc.createProduct + PUT produkt (mirror features)
//
// Uzywa: discovery.apiWithRetry (throttle + retry na 429).
//
// Data: 2026-09-08 (refactor pod model wariantow, bez VAT)

'use strict';

const client = require('./client.cjs');
const disc = require('./discovery.cjs');
const mapper = require('./mapper_v2.cjs');
const { globalLimiter } = require('./rate_limiter.cjs');
const { apiWithRetry } = disc;

/**
 * Zbierz produkty dostawcy do pelnego sync.
 * Zwraca wiersze z JOIN selly_products - moze byc cache_hit lub bez mapowania.
 */
function collectFullSyncItems(db, dostawca) {
  const rows = db.prepare(`
    SELECT
      p.kod, p.kod_importu, p.dostawca, p.ean, p.nazwa,
      p.marka, p.kategoria, p.status, p.stan, p.waga,
      p.cena_sprzedazy, p.cena_zakupu, p.vat,
      p.bieznik, p.rozmiar, p.szerokosc, p.profil, p.srednica,
      p.rozmiar_alternatywny, p.konstrukcja, p.pr, p.tl_tt,
      p.indeksy, p.indeks_nosnosci, p.indeks_predkosci, p.dot,
      p.zastosowanie, p.label_wet, p.label_rolling, p.label_noise,
      p.ms, p.snow_3pmsf, p.label_snow, p.ean_is_valid,
      p.kod_dostawcy,
      sp.selly_product_id, sp.selly_variant_id, sp.feature_id_magazyn,
      sp.stan_wyslany, sp.cena_sprzedazy_wyslana, sp.cena_zakupu_wyslana
    FROM products p
    LEFT JOIN selly_products sp ON sp.kod_importu = p.kod_importu AND sp.dostawca = p.dostawca
    WHERE p.dostawca = ?
      AND p.status = 'aktywny'
      AND p.kod_importu IS NOT NULL AND p.kod_importu != ''
    ORDER BY p.kod
  `).all(dostawca);
  return rows;
}

/**
 * Wczytaj slowniki dla POST /api/products (Tor 2 auto-create):
 *   - catMap: klucz=kategoria_raw (np. 'Rolnicze'/'Cieżarowe') -> category_id_glowna
 *     Zrodlo: selly_kategoria_norm_map (mapowanie kategorii Bridge na Selly hierarchie 1/137/259/377)
 *   - prodMap: klucz=marka.toLowerCase() -> producer_id
 *     Zrodlo: selly_dict.producers
 *   - whMap: klucz=magazyn_slug -> warehouse_id
 *     Zrodlo: selly_dict.warehouses
 *
 * UWAGA: uzywamy selly_kategoria_norm_map (nie selly_dict.categories), bo Selly ma glebsza
 * hierarchie kategorii (Opony rolnicze = id=1 podstawowe, ale Opony przemyslowe=137, ciezarowe=259,
 * lesne=377 - to sa aktualnie uzywane id). selly_dict.categories to zaslepka z 4 rowmzu wpisow.
 */
function loadDictMaps(db) {
  const maps = { catMap: new Map(), prodMap: new Map(), whMap: new Map() };

  // Kategorie - z norm_map (klucz zawiera warianty pisowni: 'Rolnicze', 'rolnicze', 'ciezarowe', etc.)
  const cats = db.prepare('SELECT kategoria_raw, category_id_glowna FROM selly_kategoria_norm_map').all();
  for (const r of cats) {
    maps.catMap.set(String(r.kategoria_raw).toLowerCase(), r.category_id_glowna);
  }

  // Producenci i magazyny - z selly_dict
  const dict = db.prepare('SELECT slownik, klucz, wartosc_id FROM selly_dict').all();
  for (const r of dict) {
    if (r.slownik === 'producers')  maps.prodMap.set(r.klucz, r.wartosc_id);
    else if (r.slownik === 'warehouses') maps.whMap.set(r.klucz, r.wartosc_id);
  }
  return maps;
}

/**
 * Log start sync do selly_sync_log.
 */
function logSyncStart(db, dostawca) {
  const info = db.prepare(`
    INSERT INTO selly_sync_log (operacja, dostawca_kod, liczba_ok, liczba_blad, liczba_skip,
                                 rozpoczeto, status)
    VALUES ('sync_full', ?, 0, 0, 0, datetime('now'), 'w_trakcie')
  `).run(dostawca || 'ALL');
  return info.lastInsertRowid;
}

function logSyncEnd(db, logId, ok, err, skip, details, status = 'zakonczono') {
  db.prepare(`
    UPDATE selly_sync_log
    SET liczba_ok = ?, liczba_blad = ?, liczba_skip = ?,
        szczegoly_json = ?, zakonczono = datetime('now'), status = ?
    WHERE id = ?
  `).run(ok, err, skip, JSON.stringify(details).slice(0, 8000), status, logId);
}

/**
 * Zapisz snapshot po udanym sync (nie ruszamy cena/stan - to robi sync_delta).
 */
function markProductSynced(db, row) {
  db.prepare(`
    UPDATE selly_products
    SET ostatnia_sync = datetime('now'), ostatni_status = 'ok', ostatni_blad = NULL,
        cena_zakupu_wyslana = ?
    WHERE kod_importu = ? AND dostawca = ?
  `).run(Number(row.cena_zakupu) || 0, row.kod_importu, row.dostawca);
}

function markError(db, row, error) {
  const errStr = String(error);
  const status = /Brak kategorii|Brak producenta/.test(errStr) ? 'missing_dict' : 'error';
  db.prepare(`
    UPDATE selly_products
    SET ostatnia_sync = datetime('now'), ostatni_status = ?, ostatni_blad = ?
    WHERE kod_importu = ? AND dostawca = ?
  `).run(status, errStr.slice(0, 500), row.kod_importu, row.dostawca);
}

/**
 * Pobierz istniejace features wariantu (dla mirror).
 */
async function fetchVariantFeatures(productId, variantId) {
  try {
    const r = await apiWithRetry('GET', `/api/products/${productId}/variants/${variantId}`);
    return r.data?.data?.features || [];
  } catch (e) {
    return [];
  }
}

/**
 * Sciezka A: wariant istnieje w cache - PUT produkt + PUT wariant (features).
 */
async function updateExistingVariant(db, row, opts) {
  const { dryRun } = opts;
  const productId = row.selly_product_id;
  const variantId = row.selly_variant_id;

  // 1. Pobierz aktualne features wariantu (dla mirror mode)
  const existingFeatures = await fetchVariantFeatures(productId, variantId);

  // 2. Payload produktu (bez VAT, bez ceny, bez stanu)
  const productPayload = mapper.toSellyPayloadV2(row, { includeFeatures: false });

  if (dryRun) {
    return { action: 'dry_A', payload_product: productPayload,
             features_count: mapper.buildFeaturesMirror(row, existingFeatures).length };
  }

  // 3. PUT /api/products/{pid} (pola produktu)
  const putProduct = await apiWithRetry('PUT', `/api/products/${productId}`, { body: productPayload });
  if (putProduct.status < 200 || putProduct.status >= 300) {
    throw new Error(`PUT product HTTP ${putProduct.status}: ${JSON.stringify(putProduct.data).slice(0, 300)}`);
  }

  // 4. PUT /api/products/{pid}/variants/{vid} (features mirror)
  const featuresMirror = mapper.buildFeaturesMirror(row, existingFeatures);
  const putVariant = await apiWithRetry('PUT',
    `/api/products/${productId}/variants/${variantId}`,
    { body: { features: featuresMirror } }
  );
  if (putVariant.status < 200 || putVariant.status >= 300) {
    throw new Error(`PUT variant HTTP ${putVariant.status}: ${JSON.stringify(putVariant.data).slice(0, 300)}`);
  }

  markProductSynced(db, row);
  return { action: 'updated_A', product_id: productId, variant_id: variantId };
}

/**
 * Sciezki B i C: brak wariantu w cache - zapewnij mapping (dispatch do discovery)
 * potem PUT produkt.
 */
async function ensureAndUpdate(db, row, dictMaps, opts) {
  const { dryRun } = opts;

  if (dryRun) {
    // Ustal ktora sciezka bez wykonania
    const hasEan = !!(row.ean);
    return { action: 'dry_BorC', hasEan, sample_payload: mapper.toSellyPayloadV2(row, { includeFeatures: true }) };
  }

  // 1. Discovery zajmie sie znalezieniem lub stworzeniem mappingu
  const mapping = await disc.ensureMapping(db, row, dictMaps);
  if (mapping.error || !mapping.variant_id) {
    throw new Error('ensureMapping: ' + (mapping.error || 'brak variant_id'));
  }

  // 2. Aktualizuj produkt (features juz zostaly ustawione przy tworzeniu przez discovery,
  //    ale PUT produktu dokona synchronizacji name/weight/ean/provider_code)
  const productPayload = mapper.toSellyPayloadV2(row, { includeFeatures: false });
  const putProduct = await apiWithRetry('PUT', `/api/products/${mapping.product_id}`, { body: productPayload });
  if (putProduct.status < 200 || putProduct.status >= 300) {
    throw new Error(`PUT product po discovery HTTP ${putProduct.status}: ${JSON.stringify(putProduct.data).slice(0, 300)}`);
  }

  // 3. Uzupelnij features wariantu (mirror z istniejacych)
  const existingFeatures = await fetchVariantFeatures(mapping.product_id, mapping.variant_id);
  const featuresMirror = mapper.buildFeaturesMirror(row, existingFeatures);
  const putVariant = await apiWithRetry('PUT',
    `/api/products/${mapping.product_id}/variants/${mapping.variant_id}`,
    { body: { features: featuresMirror } }
  );
  if (putVariant.status < 200 || putVariant.status >= 300) {
    throw new Error(`PUT variant features HTTP ${putVariant.status}: ${JSON.stringify(putVariant.data).slice(0, 300)}`);
  }

  markProductSynced(db, row);
  return {
    action: mapping.action === 'created_product' ? 'created_C' : 'created_variant_B',
    product_id: mapping.product_id, variant_id: mapping.variant_id,
    discovery_action: mapping.action,
  };
}

/**
 * GLOWNA FUNKCJA Tor 2.
 * @param {Object} db
 * @param {string} dostawca
 * @param {Object} opts - { dryRun: bool, maxProducts: int, autoCreate: bool, limit: int }
 */
async function syncFullForDostawca(db, dostawca, opts = {}) {
  const { dryRun = false, maxProducts = 5000, autoCreate = true } = opts;

  if (!dostawca) throw new Error('sync_full: dostawca wymagany');

  const startTs = Date.now();
  const rows = collectFullSyncItems(db, dostawca);
  const limited = rows.slice(0, maxProducts);

  const dictMaps = loadDictMaps(db);
  const logId = logSyncStart(db, dostawca);

  const stats = {
    total: limited.length,
    updated_A: 0, created_variant_B: 0, created_C: 0,
    err: 0, skip: 0, dry: 0,
  };
  const errors = [];
  const details = { dostawca, dryRun, autoCreate };

  console.log(`[sync_full] Start: dostawca=${dostawca}, ${limited.length} produktow, dryRun=${dryRun}, autoCreate=${autoCreate}`);

  for (const row of limited) {
    try {
      let result;
      if (row.selly_variant_id) {
        // Sciezka A
        result = await updateExistingVariant(db, row, { dryRun });
      } else {
        // Sciezka B lub C - discovery zdecyduje
        if (!autoCreate) {
          stats.skip++;
          continue;
        }
        result = await ensureAndUpdate(db, row, dictMaps, { dryRun });
      }

      if (dryRun) {
        stats.dry++;
      } else if (result.action === 'updated_A') {
        stats.updated_A++;
      } else if (result.action === 'created_variant_B') {
        stats.created_variant_B++;
      } else if (result.action === 'created_C') {
        stats.created_C++;
      }
    } catch (e) {
      stats.err++;
      errors.push({ kod: row.kod, kod_importu: row.kod_importu, error: e.message.slice(0, 300) });
      if (!dryRun) markError(db, row, e.message);
    }
  }

  const durationMs = Date.now() - startTs;
  details.stats = stats;
  details.duration_ms = durationMs;
  details.sample_errors = errors.slice(0, 20);
  details.limiter = globalLimiter.getStats?.() || null;

  const totalOk = stats.updated_A + stats.created_variant_B + stats.created_C;
  logSyncEnd(db, logId, totalOk, stats.err, stats.skip + stats.dry, details,
             stats.err > 0 && totalOk === 0 ? 'blad' : 'zakonczono');

  console.log(`[sync_full] Koniec: A=${stats.updated_A}, B=${stats.created_variant_B}, C=${stats.created_C}, err=${stats.err}, skip=${stats.skip}, dry=${stats.dry}, time=${(durationMs/1000).toFixed(1)}s`);
  return { stats, errors, logId, durationMs };
}

module.exports = {
  syncFullForDostawca,
  collectFullSyncItems,
  loadDictMaps,
};
