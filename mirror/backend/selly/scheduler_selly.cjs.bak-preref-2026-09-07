// backend/selly/scheduler_selly.cjs
// Scheduler dla synchronizacji Bridge -> Selly.
//
// Tor 1 (DELTA - stan/cena):
//   - Uruchamia sie o HH:55 dla dostawcow ktorzy maja auto-pull o HH:54
//   - Fallback: co 15 min sprawdza wszystkich dostawcow (dla recznych aktualizacji)
//
// Tor 2 (PELNY MIRROR + auto-create):
//   - Kadencja: codziennie 02:00-04:00
//   - Rotacja per dostawca:
//        02:00 pon: MO1, MO2      02:00 wt: MO3, MO4      02:00 sr: MO5, MO6
//        02:00 czw: MO9           02:00 pt: MO10           02:00 sob: MO7 (raz/mc = pierwsza sobota)
//                                                          02:00 nie: MO8 (raz/mc = pierwsza niedziela)
//   - MO7/MO8 rzadko (stan zawsze 0/dostepnosc = 0)
//
// Data: 2026-09-07

'use strict';

const { syncDeltaForDostawca } = require('./sync_delta.cjs');
const { syncFullForDostawca } = require('./sync_full.cjs');
const { globalLimiter } = require('./rate_limiter.cjs');

const ACTIVE_SUPPLIERS = ['MO1', 'MO2', 'MO3', 'MO4', 'MO5', 'MO6', 'MO7', 'MO8', 'MO9', 'MO10'];

// Rotacja Toru 2 per dzien tygodnia (0=Nie, 1=Pon, ..., 6=Sob)
const FULL_ROTATION = {
  1: ['MO1', 'MO2'],
  2: ['MO3', 'MO4'],
  3: ['MO5', 'MO6'],
  4: ['MO9'],
  5: ['MO10'],
  6: ['MO7'], // pierwsza sobota miesiaca
  0: ['MO8'], // pierwsza niedziela miesiaca
};

function isFirstOfMonthDay(date, targetDow) {
  // Czy `date` to pierwsza wystapienie dnia tygodnia `targetDow` w danym miesiacu
  if (date.getDay() !== targetDow) return false;
  return date.getDate() <= 7;
}

/**
 * Wybierz dostawcow do Toru 2 w danej dacie.
 */
function suppliersForFullToday(date = new Date()) {
  const dow = date.getDay();
  const scheduled = FULL_ROTATION[dow] || [];
  return scheduled.filter(s => {
    if (s === 'MO7') return isFirstOfMonthDay(date, 6);
    if (s === 'MO8') return isFirstOfMonthDay(date, 0);
    return true;
  });
}

/**
 * Uruchom Tor 1 dla wszystkich dostawcow (fallback co 15 min).
 */
async function runDeltaAll(db, opts = {}) {
  const suppliers = opts.suppliers || ACTIVE_SUPPLIERS;
  const results = [];
  for (const s of suppliers) {
    try {
      const r = await syncDeltaForDostawca(db, s, opts);
      results.push(r);
      if (r.priceCandidates || r.stockCandidates) {
        console.log(`[Selly Tor1] ${s}: prices=${r.priceCandidates}, stock=${r.stockCandidates}, ok=${r.synced}, err=${r.errors}`);
      }
    } catch (e) {
      results.push({ ok: false, dostawca: s, error: e.message });
      console.error(`[Selly Tor1] ${s} FATAL:`, e.message);
    }
  }
  return results;
}

/**
 * Uruchom Tor 2 dla dostawcow zaplanowanych na dzis.
 */
async function runFullTodays(db, opts = {}) {
  const suppliers = opts.forceSuppliers || suppliersForFullToday(new Date());
  const results = [];
  for (const s of suppliers) {
    try {
      const r = await syncFullForDostawca(db, s, opts);
      results.push(r);
      console.log(`[Selly Tor2] ${s}: existing=${r.existingCount}, missing=${r.missingCount}, upd=${r.updated}, cre=${r.created}, err=${r.errors}`);
    } catch (e) {
      results.push({ ok: false, dostawca: s, error: e.message });
      console.error(`[Selly Tor2] ${s} FATAL:`, e.message);
    }
  }
  return results;
}

/**
 * Zainstaluj scheduler w procesie.
 * Wywoluje callback co minute, sam dobiera czy trzeba cos uruchomic.
 */
function installScheduler(db, opts = {}) {
  const CHECK_INTERVAL_MS = 60_000; // co minute sprawdz czy jest cos do zrobienia
  let lastFullDate = null; // yyyy-mm-dd zeby nie duplikowac

  const tick = async () => {
    const now = new Date();
    const hh = now.getHours();
    const mm = now.getMinutes();
    const dateKey = now.toISOString().substring(0, 10);

    // --- Tor 1 event-driven po auto-pull (HH:54) - odpalamy o HH:55 ---
    if (mm === 55) {
      console.log(`[Selly Scheduler] Tor1 event-driven ${hh}:55`);
      runDeltaAll(db, opts).catch(e => console.error('[Selly Scheduler] Tor1 err:', e.message));
    }

    // --- Tor 1 fallback co 15 min (HH:10, HH:25, HH:40) ---
    if (mm === 10 || mm === 25 || mm === 40) {
      console.log(`[Selly Scheduler] Tor1 fallback ${hh}:${String(mm).padStart(2, '0')}`);
      runDeltaAll(db, opts).catch(e => console.error('[Selly Scheduler] Tor1 err:', e.message));
    }

    // --- Tor 2 raz dziennie o 02:00 ---
    if (hh === 2 && mm === 0 && lastFullDate !== dateKey) {
      lastFullDate = dateKey;
      const scheduled = suppliersForFullToday(now);
      if (scheduled.length > 0) {
        console.log(`[Selly Scheduler] Tor2 start 02:00 - suppliers:`, scheduled.join(', '));
        runFullTodays(db, opts).catch(e => console.error('[Selly Scheduler] Tor2 err:', e.message));
      } else {
        console.log('[Selly Scheduler] Tor2 - brak dostawcow zaplanowanych na dzis');
      }
    }
  };

  const timer = setInterval(tick, CHECK_INTERVAL_MS);
  console.log('[Selly Scheduler] Zainstalowany. Tor1: HH:55 + HH:10/25/40. Tor2: codziennie 02:00 (rotacja).');
  return () => clearInterval(timer);
}

module.exports = {
  installScheduler,
  runDeltaAll,
  runFullTodays,
  suppliersForFullToday,
  ACTIVE_SUPPLIERS,
  FULL_ROTATION,
};
