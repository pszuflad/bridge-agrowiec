# ── Bridge backend — zmienne środowiskowe ────────────────────────────────────
# Skopiuj do .env i uzupełnij. .env NIE trafia do repo (patrz .gitignore).

# Adres nasłuchu. Staging: HOST=127.0.0.1 PORT=5001 (za proxy Apache).
HOST=127.0.0.1
PORT=5001

# Ścieżka do pliku bazy SQLite. Staging: ~/private_apps/bridge-staging/data/data-nowy.db
DB_PATH=./data/bridge.db

# WYMAGANY. Sekret do podpisywania JWT — bez niego serwer nie wstanie (fail-fast).
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# development | test | production
NODE_ENV=development

# Lista dozwolonych originów CORS po przecinku. Pusta = CORS wyłączony (domyślnie).
# Staging i produkcja są same-origin przez proxy — zostaw puste.
# Lokalny dev frontendu: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# Nadpisuje flagę Secure cookie sesji. Domyślnie: true gdy NODE_ENV=production.
# COOKIE_SECURE=false

# Katalog archiwum plików importu. Domyślnie: <cwd>/import_archive.
# IMPORT_ARCHIVE_DIR=./import_archive

# ── Scheduler importu (blok 3f-3) ────────────────────────────────────────────
# Automatyczny polling dostawców z sposobDostarczania=url. DOMYŚLNIE WYŁĄCZONY —
# świadome odstępstwo od produkcji, która ma go włączonego na sztywno.
# Włączony odpytuje PIĘCIU dostawców (MO2, MO3, MO4, MO5, MO9) co 60 min, czyli
# 120 pobrań na dobę z REALNYCH serwerów dostawców, i przy każdej nieudanej próbie
# dopisuje alert (bez dławika — decyzja 3f-2). Na stagingu włączaj świadomie.
# IMPORT_SCHEDULER=true

# Przebieg zaraz po starcie, poza cyklem — działa tylko razem z IMPORT_SCHEDULER.
# Bez tego pierwsze pobranie jest dopiero PO pełnym interwale (60 min), więc po
# włączeniu automatu przez godzinę nie widać, czy w ogóle wystartował. Dostawcy
# ruszają z rozrzutem 5 s, żeby nie uderzyć w pięć serwerów w tej samej sekundzie.
# IMPORT_SCHEDULER_PIERWSZY_PRZEBIEG=true
