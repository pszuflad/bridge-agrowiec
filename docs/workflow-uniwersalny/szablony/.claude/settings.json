{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(tree:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",

      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-remote:*)",

      "Bash(gh pr:*)",
      "Bash(gh api user:*)",
      "Bash(gh auth status)",

      "Bash(tools/sync-z-bazy.sh:*)",
      "Bash(tools/push-i-pr.sh:*)",
      "Bash(tools/bramki.sh:*)",

      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)"
